<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Castar</RootNamespace>
    <Version>0.11.23</Version>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Copyright>krislechy</Copyright>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="logo.ico" />
    <None Update="Licenses/Lucide.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="ZXingCpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Castar.Api\Castar.Api.csproj" />
    <ProjectReference Include="..\Castar.ReleaseUpdates\Castar.ReleaseUpdates.csproj" />
    <ProjectReference Include="..\Castar.Domain\Castar.Domain.csproj" />
    <ProjectReference Include="..\Castar.Logger\Castar.Logger.csproj" />
    <ProjectReference Include="..\Castar.TrayNotify.Windows\Castar.TrayNotify.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Styles\ContextMenu.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

</Project>
