<UserControl x:Class="Castar.Compontents.BudgetCategoryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="304" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="CategoryIconTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Castar.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{DynamicResource Castar.Field}" BorderThickness="1"
                                BorderBrush="{DynamicResource Castar.FieldBorder}" CornerRadius="{DynamicResource Castar.Corner.Control}">
                            <Grid>
                                <Border x:Name="Hover" Opacity="0" Background="{DynamicResource Main.MouseOver}"
                                        IsHitTestVisible="False" CornerRadius="{DynamicResource Castar.Corner.Control}"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop"><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/></Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Castar.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Castar.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="{Binding Label}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        </Style>
        <Style x:Key="CategoryTagRemoveButton" TargetType="Button" BasedOn="{StaticResource Castar.SecondaryButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Gray}"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock x:Name="NameLabel" Text="Название" Style="{StaticResource FormFieldLabel}"/>
        <TextBox x:Name="NameInput" MaxLength="100" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
        <TextBlock x:Name="TagLabel" Text="Теги" Style="{StaticResource FormFieldLabel}" Margin="0,12,0,4"/>
        <Grid>
            <TextBox x:Name="TagInput" AutomationProperties.LabeledBy="{Binding ElementName=TagLabel}"
                     PreviewKeyDown="TagInput_PreviewKeyDown" TextChanged="TagInput_TextChanged"/>
            <TextBlock Text="Добавить тег" Foreground="{DynamicResource Foreground.Gray}" IsHitTestVisible="False"
                       Margin="12,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TagInput}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="TagWarning" Style="{StaticResource BudgetOptionalText}" Foreground="{DynamicResource Warning.Svg.Brush}"
                   Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
        <ItemsControl x:Name="TagChips" Margin="0,8,0,0" AutomationProperties.Name="Теги" Focusable="False">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,6" MaxWidth="296" Padding="8,2,2,2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Top"
                            Background="{DynamicResource Castar.Selection}" BorderBrush="{DynamicResource Castar.FieldBorder}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource CategoryTagRemoveButton}"
                                    AutomationProperties.Name="{Binding StringFormat='Удалить тег {0}'}" Click="RemoveTag_Click">
                                <Path Data="{StaticResource Lucide.x}" Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Foreground.White}" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,14,0,2" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Без иконки" Click="ClearIcon_Click"
                    Style="{StaticResource Castar.SecondaryButton}" Padding="8,2" MinHeight="26"/>
            <TextBlock x:Name="IconLabel" Text="Иконка" Style="{StaticResource FormFieldLabel}" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>
        <ListBox x:Name="IconPicker" SelectedValuePath="Key" BorderThickness="0" Background="Transparent"
                 Margin="-4,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource CategoryIconTile}"
                 AutomationProperties.LabeledBy="{Binding ElementName=IconLabel}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Path Data="{Binding Shape}" Width="17" Height="17" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
