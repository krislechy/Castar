<UserControl x:Class="Castar.Compontents.BudgetCategoryTagsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="304" MaxWidth="348" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ListView x:Name="TagsList" MaxHeight="280" Padding="0" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Теги категории">
            <ListView.Style>
                <Style TargetType="ListView" BasedOn="{StaticResource BudgetList}">
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Castar.Field}" CornerRadius="{DynamicResource Castar.Corner.Control}"
                            Margin="0,0,8,0" Padding="10,3,4,3">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Castar.SecondaryButton}" Click="RemoveTag_Click"
                                    ToolTip="Удалить тег" AutomationProperties.Name="{Binding StringFormat='Удалить тег {0}'}"
                                    Width="28" Height="28" MinHeight="28" Padding="7" Margin="8,0,0,0"
                                    Background="Transparent" BorderThickness="0" IsTabStop="False">
                                <Path Data="{StaticResource Lucide.x}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource Foreground.Gray}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource Foreground.White}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="Нет тегов" Foreground="{DynamicResource Foreground.Gray}" Margin="0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=TagsList}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
