<UserControl x:Class="Castar.Compontents.CategorizationPromptEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel>
        <TextBox x:Name="PromptInput" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                 Height="216" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Промпт категоризации"/>
        <Button x:Name="ResetPromptButton" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Сбросить"
                Style="{StaticResource Castar.SecondaryButton}" Click="Reset_Click"/>
    </StackPanel>
</UserControl>
