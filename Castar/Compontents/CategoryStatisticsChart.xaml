<UserControl x:Class="Castar.Compontents.CategoryStatisticsChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             xmlns:api="clr-namespace:Castar.Api;assembly=Castar.Api"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <c:BudgetCategoryIconConverter x:Key="CategoryIcon"/>
        <Style x:Key="CategoryChartList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Style="{DynamicResource LedgerScrollViewer}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CategoryPlotTemplate">
            <Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource CategoryChartList}"
                              AutomationProperties.Name="Суммы по категориям">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <DockPanel Margin="0,0,0,5" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="12,0,0,0"
                                               Foreground="{DynamicResource Foreground.White}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource CategoryIcon}}"
                                          Margin="0,0,8,0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Stroke="{DynamicResource Foreground.Gray}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource Foreground.White}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Height="6" Background="{DynamicResource Castar.Field}" CornerRadius="3" IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BeforeNegative}"/>
                                            <ColumnDefinition Width="{Binding Negative}"/>
                                            <ColumnDefinition Width="{Binding Positive}"/>
                                            <ColumnDefinition Width="{Binding AfterPositive}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" CornerRadius="3" Background="{DynamicResource Foreground.Negative}"/>
                                        <Border Grid.Column="2" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Highlight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Button.Foreground.Green}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BudgetOptionalText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Foreground.Gray}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <c:StatisticsChartCard x:Name="ChartCard" Title="По категориям" HeaderIcon="{StaticResource Lucide.tags}">
        <c:StatisticsChartCard.HeaderAction>
            <StackPanel Orientation="Horizontal">
                <c:CastarComboBox x:Name="KindPicker" MinWidth="94" Margin="0,0,8,0" SelectedValuePath="Tag"
                                  AutomationProperties.Name="Операции на графике по категориям" SelectedIndex="0"
                                  SelectionChanged="KindPicker_SelectionChanged">
                    <ComboBoxItem Tag="{x:Static api:BudgetEvents.Purchase}" Content="Расходы"/>
                    <ComboBoxItem Tag="{x:Static api:BudgetEvents.Income}" Content="Доходы"/>
                </c:CastarComboBox>
                <Button x:Name="FilterButton" Content="Категории" IsEnabled="False"
                        Style="{StaticResource Castar.SecondaryButton}" Click="FilterButton_Click"/>
                <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                       AllowsTransparency="True" StaysOpen="False" Opened="FilterPopup_Opened">
                    <Border Style="{StaticResource Castar.Panel}" Padding="10,6" Width="224"
                            KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="FilterPopup_PreviewKeyDown">
                        <ItemsControl x:Name="FilterChoices" MaxHeight="240" Focusable="True" Style="{StaticResource CategoryChartList}"
                                      AutomationProperties.Name="Показывать категории">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="FilterChoice_Click" Margin="2,5">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </StackPanel>
        </c:StatisticsChartCard.HeaderAction>
    </c:StatisticsChartCard>
</UserControl>
