<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.ManualCurrencyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Castar.Compontents"
             Loaded="Panel_Loaded" Unloaded="Panel_Unloaded">
    <StackPanel MinWidth="280">
        <TextBlock x:Name="DefaultLabel" Text="Валюта ручного добавления" Style="{StaticResource FormFieldLabel}"/>
        <local:CastarComboBox ItemsSource="{Binding EnabledCurrencies}"
                              SelectedItem="{Binding DefaultCurrency, Mode=TwoWay}"
                              AutomationProperties.LabeledBy="{Binding ElementName=DefaultLabel}"/>
        <TextBlock x:Name="CurrencyListLabel" Text="Разрешённые валюты" Style="{StaticResource FormFieldLabel}"/>
        <TextBlock x:Name="CurrencySearchLabel" Text="Поиск валюты" Style="{StaticResource FormFieldLabel}"/>
        <TextBox x:Name="CurrencySearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=CurrencySearchLabel}"/>
        <ListView ItemsSource="{Binding FilteredCurrencies}" MaxHeight="240" Style="{StaticResource BudgetList}"
                  AutomationProperties.LabeledBy="{Binding ElementName=CurrencyListLabel}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{Binding Label}">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource ViewStatus}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
