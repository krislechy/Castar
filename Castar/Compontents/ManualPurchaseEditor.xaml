<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.ManualPurchaseEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="465" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="465" Margin="0,0,12,0">
            <ContentControl x:Name="HeaderFields"/>
            <StackPanel x:Name="ItemFields" Margin="0,12,0,0"/>
            <Button Content="Добавить товар" Click="AddItem_Click" HorizontalAlignment="Left"
                    Style="{StaticResource FormAction}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
