<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.ManualPurchaseEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Castar;component/Styles/ManualPurchaseForm.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Scope the existing controls' shared palette lookups to this form. -->
            <SolidColorBrush x:Key="Highlight" Color="{Binding Color, Source={StaticResource PurchaseForm.Focus}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Foreground.White" Color="{Binding Color, Source={StaticResource PurchaseForm.Foreground}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Foreground.Gray" Color="{Binding Color, Source={StaticResource PurchaseForm.Muted}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Button.Foreground" Color="{Binding Color, Source={StaticResource PurchaseForm.Muted}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Main.Background.lvl2" Color="{Binding Color, Source={StaticResource PurchaseForm.Field}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Main.Background.lvl3" Color="{Binding Color, Source={StaticResource PurchaseForm.FieldBorder}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Main.Top.Panel" Color="{Binding Color, Source={StaticResource PurchaseForm.FieldBorder}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Main.MouseOver" Color="{Binding Color, Source={StaticResource PurchaseForm.Hover}, Mode=OneTime}"/>
            <SolidColorBrush x:Key="Main.MousePressed" Color="{Binding Color, Source={StaticResource PurchaseForm.Pressed}, Mode=OneTime}"/>
            <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel MinWidth="536" Margin="0,0,8,0">
        <ContentControl x:Name="HeaderFields" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch"/>
        <CheckBox x:Name="RepeatPurchase" Content="Повторять покупку" Margin="0,12,0,4"/>
        <Grid Margin="0,4,0,0"
              Visibility="{Binding IsChecked, ElementName=RepeatPurchase, Converter={StaticResource PurchaseFormVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="FrequencyLabel" Style="{StaticResource FormFieldLabel}" Text="Периодичность"/>
                <c:CastarComboBox x:Name="FrequencyPicker" DisplayMemberPath="Label" SelectedValuePath="Value"
                                 AutomationProperties.LabeledBy="{Binding ElementName=FrequencyLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="ScheduleZoneLabel" Style="{StaticResource FormFieldLabel}" Text="Часовой пояс"/>
                <c:CastarComboBox x:Name="ScheduleZonePicker" DisplayMemberPath="Label" SelectedValuePath="Id"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ScheduleZoneLabel}"/>
            </StackPanel>
        </Grid>
        <Separator Margin="0,16,0,0" Background="{StaticResource PurchaseForm.Divider}"/>
        <StackPanel x:Name="ItemFields"/>
        <Grid Margin="0,8,0,0">
            <Rectangle RadiusX="8" RadiusY="8" Fill="{StaticResource PurchaseForm.Action}" Stroke="{StaticResource PurchaseForm.FieldBorder}"
                       StrokeDashArray="4,2" StrokeThickness="1" IsHitTestVisible="False"/>
            <Button x:Name="AddItemButton" Click="AddItem_Click" Style="{StaticResource FormAction}"
                    AutomationProperties.Name="Добавить товар" HorizontalContentAlignment="Left"
                    Foreground="{StaticResource PurchaseForm.Accent}" IsTabStop="False" MinHeight="40" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Lucide.plus}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{StaticResource PurchaseForm.Accent}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Добавить товар" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
