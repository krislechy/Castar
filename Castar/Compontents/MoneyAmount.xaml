<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.MoneyAmount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Control"
             Focusable="False" IsTabStop="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        </Style>
    </UserControl.Style>
    <StackPanel>
        <TextBlock x:Name="PrimaryAmount" Typography.NumeralAlignment="Tabular" Foreground="{Binding Foreground, ElementName=Control}"
                   TextAlignment="{Binding AmountAlignment, ElementName=Control}">
            <TextBlock.Text><MultiBinding StringFormat="{}{0}{1}"><Binding Path="Prefix" ElementName="Control"/><Binding Path="Display.Primary" ElementName="Control"/></MultiBinding></TextBlock.Text>
        </TextBlock>
        <TextBlock x:Name="OriginalAmount" Typography.NumeralAlignment="Tabular"
                   Text="{Binding Display.Original, ElementName=Control, TargetNullValue='', FallbackValue=''}"
                   TextAlignment="{Binding AmountAlignment, ElementName=Control}"
                   Style="{StaticResource ViewStatus}" Margin="0" FontSize="12" FontWeight="Normal"/>
    </StackPanel>
</UserControl>
