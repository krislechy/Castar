<UserControl x:Class="Castar.Compontents.MoneyAmount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Control"
             Focusable="False" IsTabStop="False" Foreground="{DynamicResource Foreground.White}">
    <StackPanel>
        <TextBlock x:Name="PrimaryAmount" Text="{Binding Display.Primary, ElementName=Control}"
                   TextAlignment="{Binding AmountAlignment, ElementName=Control}"/>
        <TextBlock x:Name="OriginalAmount"
                   Text="{Binding Display.Original, ElementName=Control, TargetNullValue='', FallbackValue=''}"
                   TextAlignment="{Binding AmountAlignment, ElementName=Control}"
                   Style="{StaticResource ViewStatus}" Margin="0" FontSize="11" FontWeight="Normal"/>
    </StackPanel>
</UserControl>
