<UserControl x:Class="Castar.Compontents.PopupDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Castar.Compontents"
             mc:Ignorable="d" 
             Background="#88000000"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             KeyboardNavigation.DirectionalNavigation="Contained"
             IsVisibleChanged="Dialog_IsVisibleChanged"
             Unloaded="Dialog_Unloaded"
             KeyDown="Dialog_KeyDown"
             MouseRightButtonDown="ButtonOutsideClickEvent"
             MouseLeftButtonDown="ButtonOutsideClickEvent"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="local:PopupDialog">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Panel.ZIndex" Value="999"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Background="{Binding Background,ElementName=border}" 
                Width="{Binding ActualWidth,ElementName=border}" 
                Height="{Binding ActualHeight,ElementName=border}"
                CornerRadius="{Binding CornerRadius,ElementName=border}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.15"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Style>
        </Border>
        <Border
            x:Name="border"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MaxWidth="700"
            MinWidth="400"
            MinHeight="150"
            BorderThickness="0"
            CornerRadius="10"
            Padding="0"
            Margin="0"
            TextElement.Foreground="White"
            TextElement.FontSize="14"
            TextElement.FontWeight="Normal"
            Background="{Binding ActiveDialog.Background,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,20,20,-10">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveDialog.Title,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="{Binding ActiveDialog.Title,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" FontSize="20" FontWeight="DemiBold"/>
                </Grid>
                <Border Grid.Row="1" Padding="20,20,20,20">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                            <ContentPresenter x:Name="DialogContent" Content="{Binding ActiveDialog.Content,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </ScrollViewer>
                        <Border Grid.Row="1" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.Warning,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid TextElement.Foreground="OrangeRed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Grid.Column="0" Content="{DynamicResource Svg.Warning}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding ActiveDialog.Warning,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Tag="ButtonsGrid" Grid.Row="2" Height="35" HorizontalAlignment="Right" Margin="0,0,8,8">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="MinWidth" Value="70"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveDialog.Type,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="Default">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button x:Name="DefaultButton" Foreground="{Binding ActiveDialog.DefaultButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" IsDefault="True"
                                Content="{Binding ActiveDialog.DefaultButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Click="DefaultEvent" Padding="15,0,15,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="MinWidth" Value="70"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveDialog.Type,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="Confirm">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button x:Name="ConfirmButton" Foreground="{Binding ActiveDialog.ConfirmButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Grid.Column="0"
                                Content="{Binding ActiveDialog.ConfirmButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                Padding="15,0,15,0"
                                Click="SuccessConfirmEvent"/>
                        <Button x:Name="CancelButton" Foreground="{Binding ActiveDialog.CancelButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Grid.Column="1"
                                Content="{Binding ActiveDialog.CancelButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                Padding="15,0,15,0"
                                Click="CancelConfirmEvent"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
