<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.PopupDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Castar.Compontents"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             KeyboardNavigation.DirectionalNavigation="Contained"
             IsVisibleChanged="Dialog_IsVisibleChanged"
             Unloaded="Dialog_Unloaded"
             KeyDown="Dialog_KeyDown"
             MouseRightButtonDown="ButtonOutsideClickEvent"
             MouseLeftButtonDown="ButtonOutsideClickEvent"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Castar;component/Styles/LedgerCards.xaml"/>
            <ResourceDictionary Source="/Castar;component/Styles/PurchaseFormPalette.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PopupDialogTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
            <Setter Property="FontSize" Value="{StaticResource Castar.Font.Heading}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PopupEditorHeaderPart" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="PopupEditorActionTemplate" TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}" SnapsToDevicePixels="True">
                <Grid>
                    <Border x:Name="Interaction" Background="Transparent" CornerRadius="{TemplateBinding Border.CornerRadius}" IsHitTestVisible="False"/>
                    <ContentPresenter x:Name="ActionContent" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    <ContentControl Style="{StaticResource Castar.ButtonBusyIndicator}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Interaction" Property="Background" Value="{StaticResource PurchaseForm.Hover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Interaction" Property="Background" Value="{StaticResource PurchaseForm.Pressed}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Frame" Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="local:ButtonLoading.IsBusy" Value="True">
                    <Setter TargetName="Frame" Property="Opacity" Value="1"/>
                    <Setter TargetName="ActionContent" Property="Opacity" Value="0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="PopupEditorAction" TargetType="Button" BasedOn="{StaticResource Castar.SecondaryButton}">
            <Setter Property="MinWidth" Value="80"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                    <Setter Property="Template" Value="{StaticResource PopupEditorActionTemplate}"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource Castar.FocusVisual}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="MinHeight" Value="42"/>
                    <Setter Property="MinWidth" Value="104"/>
                    <Setter Property="Border.CornerRadius" Value="8"/>
                    <Setter Property="Typography.Capitals" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PopupDialogDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="FontSize" Value="{StaticResource Castar.Font.Body}"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="local:PopupDialog">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Panel.ZIndex" Value="999"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition x:Name="RetainedGap" Width="0"/>
            <ColumnDefinition x:Name="RetainedColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="PresentationLayer">
        <Border Background="{Binding Background,ElementName=border}"
                Width="{Binding ActualWidth,ElementName=border}"
                Height="{Binding ActualHeight,ElementName=border}"
                CornerRadius="{Binding CornerRadius,ElementName=border}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Style>
        </Border>
        <Border
            x:Name="border"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MaxWidth="700"
            MinWidth="400"
            MinHeight="150"
            Padding="0"
            Margin="0"
            TextElement.Foreground="{DynamicResource Foreground.White}"
            TextElement.FontSize="14"
            TextElement.FontWeight="Normal">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Castar.Panel}">
                    <Setter Property="Background" Value="{Binding ActiveDialog.Background, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"/>
                    <Setter Property="CornerRadius" Value="16"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PurchaseForm.DialogBackground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,24,24,0">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveDialog.Title,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <DockPanel>
                        <Button x:Name="EditorCloseButton" DockPanel.Dock="Right" Width="32" Height="32" MinHeight="32"
                                VerticalAlignment="Center" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"
                                Click="CancelConfirmEvent" FocusVisualStyle="{StaticResource Castar.FocusVisual}" Background="Transparent"
                                Template="{StaticResource PopupEditorActionTemplate}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LedgerIconButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Border.CornerRadius" Value="7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.IsConfirming, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource Lucide.x}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{StaticResource PurchaseForm.Muted}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Border x:Name="EditorIconBadge" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10"
                                Margin="0,0,14,0" Background="{StaticResource PurchaseForm.Badge}"
                                Style="{StaticResource PopupEditorHeaderPart}">
                            <Path Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{Binding ActiveDialog.EditorIcon, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                  Stroke="{StaticResource PurchaseForm.Accent}" StrokeThickness="1.55"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <TextBlock Text="{Binding ActiveDialog.Title,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                   VerticalAlignment="Center" Style="{StaticResource PopupDialogTitle}"/>
                    </DockPanel>
                </Grid>
                <Border Grid.Row="1" Padding="24,16,24,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="DialogScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Setter Property="MaxHeight" Value="500"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="MaxHeight" Value="535"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True"/>
                                                <Condition Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Padding" Value="0,0,12,0"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ContentPresenter x:Name="DialogContent" Content="{Binding ActiveDialog.Content,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveDialog.IsConfirming, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                    <DataTemplate DataType="{x:Type system:String}">
                                        <TextBlock Text="{Binding}" Style="{StaticResource PopupDialogDescription}"/>
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </ScrollViewer>
                        <Border Grid.Row="1" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.Warning,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid TextElement.Foreground="OrangeRed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Grid.Column="0" Content="{DynamicResource Svg.Warning}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding ActiveDialog.Warning,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Height="1" Margin="24,0" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{StaticResource PurchaseForm.Divider}" Style="{StaticResource PopupEditorHeaderPart}"/>
                <Grid Tag="ButtonsGrid" Grid.Row="2" MinHeight="36" HorizontalAlignment="Right">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="24,0,24,20"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                    <Setter Property="Margin" Value="24,14,24,20"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="MinWidth" Value="70"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveDialog.Type,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="Default">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button x:Name="DefaultButton" Style="{StaticResource Castar.SecondaryButton}" Foreground="{Binding ActiveDialog.DefaultButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" IsDefault="True"
                                Content="{Binding ActiveDialog.DefaultButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Click="DefaultEvent" Padding="16,8" MinWidth="80"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="MinWidth" Value="70"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveDialog.Type,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="Confirm">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button x:Name="ConfirmButton"
                                Content="{Binding ActiveDialog.ConfirmButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                local:ButtonLoading.IsBusy="{Binding ActiveDialog.IsConfirming, RelativeSource={RelativeSource AncestorType=local:PopupDialog}, FallbackValue=False}"
                                Padding="16,8"
                                Click="SuccessConfirmEvent">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PopupEditorAction}">
                                    <Setter Property="Foreground" Value="{Binding ActiveDialog.ConfirmButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="Grid.Column" Value="1"/>
                                            <Setter Property="Margin" Value="8,0,0,0"/>
                                            <Setter Property="Background" Value="{StaticResource PurchaseForm.PrimaryAction}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PurchaseForm.PrimaryBorder}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CancelButton"
                                Content="{Binding ActiveDialog.CancelButton.Text,RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"
                                Padding="16,8"
                                Click="CancelConfirmEvent">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PopupEditorAction}">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Margin" Value="8,0,0,0"/>
                                    <Setter Property="Foreground" Value="{Binding ActiveDialog.CancelButton.Foreground, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDialog.IsConfirming, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActiveDialog.HasEditorHeader, RelativeSource={RelativeSource AncestorType=local:PopupDialog}}" Value="True">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="{StaticResource PurchaseForm.Action}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PurchaseForm.FieldBorder}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        </Grid>
        <Grid x:Name="RetainedDialogLayer" Grid.Column="2"/>
    </Grid>
</UserControl>
