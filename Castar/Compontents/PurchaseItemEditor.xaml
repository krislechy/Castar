<UserControl x:Class="Castar.Compontents.PurchaseItemEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents">
    <Grid MinWidth="330">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
            <TextBlock x:Name="NameLabel" Text="Название" Style="{StaticResource FormFieldLabel}"/>
            <TextBox x:Name="ItemName" MaxLength="400" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock x:Name="QuantityLabel" Text="Количество" Style="{StaticResource FormFieldLabel}"/>
            <c:DecimalInput x:Name="Quantity" FractionDigits="-1" AutomationProperties.LabeledBy="{Binding ElementName=QuantityLabel}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="PriceLabel" Text="Цена" Style="{StaticResource FormFieldLabel}"/>
            <c:DecimalInput x:Name="UnitPrice" FractionDigits="-1" AutomationProperties.LabeledBy="{Binding ElementName=PriceLabel}"/>
        </StackPanel>
    </Grid>
</UserControl>
