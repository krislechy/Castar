<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.PurchaseItemEditor" x:Name="Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents">
    <UserControl.Resources>
        <ResourceDictionary Source="/Castar;component/Styles/ManualPurchaseForm.xaml"/>
    </UserControl.Resources>
    <Grid MinWidth="330" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,8,0">
            <TextBlock x:Name="NameLabel" Text="Название" Style="{StaticResource FormFieldLabel}"/>
            <Grid>
                <TextBox x:Name="ItemName" MaxLength="400" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                         Style="{StaticResource PurchaseFormTextBox}" Tag="{Binding UsesPurchaseFormStyle, ElementName=Editor}"/>
                <TextBlock x:Name="ItemNamePlaceholder" Text="Товар"
                           Style="{StaticResource PurchaseFormPlaceholder}" Tag="{Binding ElementName=ItemName}"/>
                <Path Style="{StaticResource PurchaseFormFieldIcon}" Data="{StaticResource PurchaseForm.ItemIcon}"
                      Visibility="{Binding UsesPurchaseFormStyle, ElementName=Editor, Converter={StaticResource PurchaseFormVisibility}}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock x:Name="QuantityLabel" Text="Количество" Style="{StaticResource FormFieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" CornerRadius="{DynamicResource InputCornerRadius}" BorderThickness="1"
                        Background="{DynamicResource Main.Background.lvl2}" IsHitTestVisible="False"
                        Visibility="{Binding IsManualEntry, ElementName=Editor, Converter={StaticResource PurchaseFormVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Main.Top.Panel}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Quantity}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Highlight}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button x:Name="DecreaseQuantityButton" Content="−" Click="DecreaseQuantity_Click"
                        Style="{StaticResource PurchaseFormStepButton}" AutomationProperties.Name="Уменьшить количество"
                        Visibility="{Binding IsManualEntry, ElementName=Editor, Converter={StaticResource PurchaseFormVisibility}}"/>
                <c:DecimalInput x:Name="Quantity" Grid.Column="1" FractionDigits="-1"
                                AutomationProperties.LabeledBy="{Binding ElementName=QuantityLabel}"/>
                <Button x:Name="IncreaseQuantityButton" Grid.Column="2" Content="+" Click="IncreaseQuantity_Click"
                        Style="{StaticResource PurchaseFormStepButton}" AutomationProperties.Name="Увеличить количество"
                        Visibility="{Binding IsManualEntry, ElementName=Editor, Converter={StaticResource PurchaseFormVisibility}}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="PriceLabel" Text="Цена" Style="{StaticResource FormFieldLabel}"/>
            <Grid>
                <c:DecimalInput x:Name="UnitPrice" FractionDigits="-1" AutomationProperties.LabeledBy="{Binding ElementName=PriceLabel}"
                                Style="{StaticResource PurchaseFormTextBox}" Tag="{Binding UsesPurchaseFormStyle, ElementName=Editor}"/>
                <TextBlock x:Name="UnitPricePlaceholder" Text="0"
                           Style="{StaticResource PurchaseFormPlaceholder}" Tag="{Binding ElementName=UnitPrice}"/>
                <Path Style="{StaticResource PurchaseFormFieldIcon}" Data="{StaticResource PurchaseForm.CurrencyIcon}"
                      Visibility="{Binding UsesPurchaseFormStyle, ElementName=Editor, Converter={StaticResource PurchaseFormVisibility}}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
            <c:BudgetCategoryPicker x:Name="ItemCategory"/>
            <CheckBox x:Name="ConfirmCategory" Content="Подтвердить категорию" Margin="0,8,0,0"
                      Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
