<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.ReceiptSourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="420" MaxWidth="420">
        <TextBlock x:Name="LegacyStatus" Text="Запрос из старой записи." Style="{StaticResource ViewStatus}"/>
        <TextBox x:Name="SourceText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="70" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Исходные данные"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="CopyButton" Content="Копировать" Style="{StaticResource FormAction}" Click="Copy_Click"/>
            <Button x:Name="QrButton" Content="Показать как QR-код" Style="{StaticResource FormAction}" Margin="8,12,0,0" Click="ShowQr_Click"/>
        </StackPanel>
        <Border x:Name="QrPanel" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                HorizontalAlignment="Center" Visibility="Collapsed">
            <Image x:Name="QrImage" Width="230" Height="230" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="QR-код исходных данных"/>
        </Border>
        <TextBlock x:Name="QrError" Text="Не удалось сформировать QR-код."
                   Visibility="Collapsed" Style="{StaticResource ViewStatus}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="CopyError" Text="Не удалось скопировать запрос."
                   Visibility="Collapsed" Style="{StaticResource ViewStatus}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
