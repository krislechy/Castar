<UserControl x:Class="Castar.Compontents.ReceiptSourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="420" MaxWidth="420">
        <TextBlock x:Name="LegacyStatus" Text="Запрос из старой записи." Style="{StaticResource ViewStatus}"/>
        <TextBox x:Name="SourceText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="70" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Исходный запрос"/>
        <Button x:Name="CopyButton" Content="Копировать" Style="{StaticResource FormAction}"
                HorizontalAlignment="Left" Click="Copy_Click"/>
        <TextBlock x:Name="CopyError" Text="Не удалось скопировать запрос."
                   Visibility="Collapsed" Style="{StaticResource ViewStatus}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
