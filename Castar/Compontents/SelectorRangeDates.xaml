<UserControl x:Class="Castar.Compontents.SelectorRangeDates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Castar.Compontents"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="700">
    <UserControl.Resources>
        <DataTemplate x:Key="PeriodPickerIconContent">
            <Path Data="{Binding}" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  IsHitTestVisible="False"/>
        </DataTemplate>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseLedgerStyle, RelativeSource={RelativeSource AncestorType=local:SelectorRangeDates}}" Value="True">
                    <Setter Property="Template" Value="{DynamicResource LedgerButtonTemplate}"/>
                    <Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="40"/>
                    <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="2,0"/>
                    <Setter Property="Background" Value="{DynamicResource LedgerSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LedgerBorder}"/><Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="local:CastarDatePicker" BasedOn="{StaticResource {x:Type local:CastarDatePicker}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseLedgerStyle, RelativeSource={RelativeSource AncestorType=local:SelectorRangeDates}}" Value="True">
                    <Setter Property="Template" Value="{DynamicResource LedgerDatePickerTemplate}"/>
                    <Setter Property="Background" Value="{DynamicResource LedgerSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LedgerBorder}"/><Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
                    <Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="2,0"/>
                    <Setter Property="CalendarStyle" Value="{DynamicResource LedgerCalendar}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="{DynamicResource Svg.LeftDoubleArrow}" Grid.Column="0" Click="OffsetYearButton_Click"
                            Width="{Binding ActualHeight,RelativeSource={RelativeSource Mode=Self}}"
                            CommandParameter="-1" ToolTip="Предыдущий год" AutomationProperties.Name="Предыдущий год"/>
        <Button Content="{DynamicResource Svg.LeftArrow}" Grid.Column="1" Click="OffsetMonthButton_Click"
                            Width="{Binding ActualHeight,RelativeSource={RelativeSource Mode=Self}}"
                            CommandParameter="-1" ToolTip="Предыдущий месяц" AutomationProperties.Name="Предыдущий месяц"/>
        <local:CastarDatePicker x:Name="StartDatePicker" Grid.Column="2"
                               SelectedDateChanged="DatePicker_SelectedStartDateChanged" AutomationProperties.Name="Начало периода"/>
        <TextBlock Grid.Column="3" Text="—" Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{StaticResource Foreground.White}"/>
        <local:CastarDatePicker x:Name="EndDatePicker" Grid.Column="4"
                               SelectedDateChanged="DatePicker_SelectedEndDateChanged" AutomationProperties.Name="Конец периода"/>
        <Button Content="{DynamicResource Svg.RightArrow}" Grid.Column="5" Click="OffsetMonthButton_Click"
                            Width="{Binding ActualHeight,RelativeSource={RelativeSource Mode=Self}}"
                            CommandParameter="1" ToolTip="Следующий месяц" AutomationProperties.Name="Следующий месяц"/>
        <Button Content="{DynamicResource Svg.RightDoubleArrow}" Grid.Column="6" Click="OffsetYearButton_Click"
                            Width="{Binding ActualHeight,RelativeSource={RelativeSource Mode=Self}}"
                            CommandParameter="1" ToolTip="Следующий год" AutomationProperties.Name="Следующий год" Cursor="Hand"/>
        <Separator x:Name="MonthPickerDivider" Grid.Column="7" Width="24" Margin="5,0"
                   VerticalAlignment="Center" IsHitTestVisible="False">
            <Separator.LayoutTransform>
                <RotateTransform Angle="90"/>
            </Separator.LayoutTransform>
        </Separator>
        <Button x:Name="MonthPickerButton" Grid.Column="8" Click="MonthPickerButton_Click"
                Content="{StaticResource Lucide.calendar-range}" ContentTemplate="{StaticResource PeriodPickerIconContent}"
                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                ToolTip="Выбрать месяц" AutomationProperties.Name="Выбрать месяц"/>
        <Button x:Name="YearPickerButton" Grid.Column="9" Click="YearPickerButton_Click"
                Content="{StaticResource Lucide.grid-2x2}" ContentTemplate="{StaticResource PeriodPickerIconContent}"
                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                ToolTip="Выбрать год" AutomationProperties.Name="Выбрать год"/>
        <Popup x:Name="MonthPopup" Grid.Column="8" PlacementTarget="{Binding ElementName=MonthPickerButton}"
               Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Opened="MonthPopup_Opened">
            <Calendar x:Name="MonthCalendar" DisplayMode="Year" Language="ru-RU"
                      Style="{Binding CalendarStyle, ElementName=StartDatePicker}"
                      AutomationProperties.Name="Месяц периода"
                      DisplayModeChanged="MonthCalendar_DisplayModeChanged" PreviewKeyDown="MonthCalendar_PreviewKeyDown"/>
        </Popup>
        <Button Grid.Column="10" Content="{DynamicResource Svg.CurrentMonth}" Click="CurrentMonth_Click"
                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                AutomationProperties.Name="Текущий месяц" ToolTip="Текущий месяц"/>
    </Grid>
</UserControl>
