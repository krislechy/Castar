<ContextMenu x:Class="Castar.Compontents.TrayContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Placement="MousePoint" Style="{DynamicResource LedgerContextMenu}" Opened="Menu_Opened">
    <ContextMenu.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Castar;component/Styles/LedgerCards.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContextMenu.Resources>
    <MenuItem x:Name="OpenItem" Header="Открыть" Style="{StaticResource LedgerMenuItem}" Click="Open_Click">
        <MenuItem.Icon>
            <Path Data="{StaticResource Lucide.panel-top-open}"
                  Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Foreground.White}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem x:Name="ExitItem" Header="Выйти" Style="{StaticResource LedgerMenuItem}" Click="Exit_Click">
        <MenuItem.Icon>
            <Path Data="{StaticResource Lucide.log-out}"
                  Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Foreground.White}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
