<UserControl x:Class="Castar.Compontents.UncategorizedStatisticsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Castar;component/Styles/LedgerCards.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CategoryJump" TargetType="Button" BasedOn="{StaticResource LedgerIconButton}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="4,5"/>
                <Setter Property="Margin" Value="-4,0"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Complete}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,6">
            <ContentControl DockPanel.Dock="Right" Content="{DynamicResource Svg.Warning}" Width="16" Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Warning.Svg.Brush}"
                            Visibility="{Binding HasMissing, Converter={StaticResource Castar.VisibleWhenTrue}}"/>
            <TextBlock Text="Категории" Style="{StaticResource GrayTextBlock}" VerticalAlignment="Center"/>
        </DockPanel>
        <Button Style="{StaticResource CategoryJump}" IsEnabled="{Binding HasPurchases}"
                Click="Purchases_Click" AutomationProperties.Name="Покупки с товарами без категории">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Покупки" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Purchases}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground.White}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ContentControl Grid.Column="2" Content="{DynamicResource Svg.RightArrow}"
                                Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Foreground="{DynamicResource Foreground.Gray}"
                                Visibility="{Binding HasPurchases, Converter={StaticResource Castar.VisibleWhenTrue}}"/>
            </Grid>
        </Button>
        <Button Style="{StaticResource CategoryJump}" IsEnabled="{Binding HasIncomes}"
                Click="Incomes_Click" AutomationProperties.Name="Доходы без категории">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Доходы" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Incomes}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Foreground.White}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ContentControl Grid.Column="2" Content="{DynamicResource Svg.RightArrow}"
                                Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Foreground="{DynamicResource Foreground.Gray}"
                                Visibility="{Binding HasIncomes, Converter={StaticResource Castar.VisibleWhenTrue}}"/>
            </Grid>
        </Button>
        <DockPanel Margin="0,6,0,0" Visibility="{Binding Complete, Converter={StaticResource Castar.VisibleWhenTrue}}">
            <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource Lucide.check}" Style="{StaticResource LucideAliasStroke}"
                          Stroke="{DynamicResource Button.Foreground.Green}"/>
                </Canvas>
            </Viewbox>
            <TextBlock Text="Все распределено" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Button.Foreground.Green}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource Foreground.Gray}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar Height="2" IsIndeterminate="True" Margin="0,4,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource Castar.VisibleWhenTrue}}"/>
    </StackPanel>
</UserControl>
