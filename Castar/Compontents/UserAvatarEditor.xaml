<UserControl UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Castar.Compontents.UserAvatarEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="168" Height="168" VerticalAlignment="Center"
                 Stroke="{DynamicResource Main.Background.lvl3}" StrokeThickness="2"
                 AutomationProperties.Name="Предпросмотр аватара">
            <Ellipse.Fill>
                <ImageBrush x:Name="Preview" Stretch="UniformToFill"/>
            </Ellipse.Fill>
        </Ellipse>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="160" VerticalAlignment="Center">
            <TextBlock x:Name="ZoomLabel" Text="Масштаб" Style="{StaticResource FormFieldLabel}"/>
            <Slider x:Name="Zoom" Style="{StaticResource FormSlider}" Minimum="1" Maximum="3" Value="1" SmallChange="0.05" LargeChange="0.2"
                    AutomationProperties.LabeledBy="{Binding ElementName=ZoomLabel}" ValueChanged="Crop_Changed"/>
            <TextBlock x:Name="HorizontalLabel" Text="По горизонтали" Style="{StaticResource FormFieldLabel}"/>
            <Slider x:Name="Horizontal" Style="{StaticResource FormSlider}" Minimum="-1" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                    AutomationProperties.LabeledBy="{Binding ElementName=HorizontalLabel}" ValueChanged="Crop_Changed"/>
            <TextBlock x:Name="VerticalLabel" Text="По вертикали" Style="{StaticResource FormFieldLabel}"/>
            <Slider x:Name="Vertical" Style="{StaticResource FormSlider}" Minimum="-1" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                    AutomationProperties.LabeledBy="{Binding ElementName=VerticalLabel}" ValueChanged="Crop_Changed"/>
        </StackPanel>
    </Grid>
</UserControl>
