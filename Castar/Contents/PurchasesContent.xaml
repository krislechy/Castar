<UserControl x:Class="Castar.Contents.PurchasesContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             Loaded="Purchases_Loaded" Unloaded="Purchases_Unloaded"
             IsVisibleChanged="Purchases_IsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PurchaseActionVisibility"/>
        <Style x:Key="ExpenseAmountWarning" TargetType="ContentControl">
            <Setter Property="Content" Value="{DynamicResource Svg.Warning}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning.Svg.Brush}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="ToolTip" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="PurchaseRowMenu" Opened="PurchaseActionMenu_Opened">
            <MenuItem Header="Показать исходные данные" Click="ShowReceiptSource_Click"
                      Visibility="{Binding HasReceiptSource, Converter={StaticResource PurchaseActionVisibility}}"/>
            <MenuItem Header="Удалить покупку" Icon="{StaticResource Svg.Remove}" Click="DeletePurchase_Click"
                      Visibility="{Binding CanDelete, Converter={StaticResource PurchaseActionVisibility}}"/>
        </ContextMenu>
        <ContextMenu x:Key="PurchaseItemRowMenu" Opened="PurchaseActionMenu_Opened">
            <MenuItem Header="Удалить товар" Icon="{StaticResource Svg.Remove}" Click="DeletePurchaseItem_Click"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BudgetHeaderSurface}">
          <WrapPanel x:Name="PeriodBar" Style="{StaticResource BudgetPeriodBar}">
            <TextBlock Text="Расходы" Style="{StaticResource BudgetHeaderTitle}"/>
            <Button Content="Добавить" Click="AddPurchase_Click" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <c:SelectorRangeDates x:Name="Dates" VerticalAlignment="Center"
                                  DateRangeChanged="Dates_DateRangeChanged"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock x:Name="ExpenseTotal" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource Highlight}" AutomationProperties.Name="Сумма расходов за период"/>
                <ContentControl x:Name="ExpenseTotalWarning" Style="{StaticResource ExpenseAmountWarning}"/>
            </StackPanel>
          </WrapPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="{StaticResource BudgetStatusMargin}"
                   Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        <Grid x:Name="BudgetContent" Grid.Row="2" Margin="{StaticResource BudgetContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="PurchasesList" Style="{StaticResource BudgetList}"
                      SelectionMode="Single" SelectionChanged="PurchasesList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Покупки за период">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Добавить покупку" Click="AddPurchase_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
                        <EventSetter Event="ContextMenuOpening" Handler="PurchaseActionMenu_Opening"/>
                        <EventSetter Event="MouseDoubleClick" Handler="PurchaseRow_DoubleClick"/>
                        <Setter Property="ContextMenu" Value="{StaticResource PurchaseRowMenu}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <c:UserAvatar Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                                          Photo="{Binding OwnerAvatar, Converter={StaticResource UserAvatarImageConverter}}"
                                          UserName="{Binding OwnerName}" ToolTip="{Binding OwnerName}"/>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource BudgetEditedMarker}"/>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Foreground.White}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding AddedOn, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <c:MoneyAmount Display="{Binding Amount}" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource ExpenseAmountWarning}" ToolTip="{Binding AmountWarning}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyPurchases" Text="Нет покупок"
                       Margin="20" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource Foreground.Gray}" Visibility="Collapsed"/>
            <c:IslandPanel x:Name="DetailsPanel" Grid.Column="2" Margin="0" Title="Товары"
                           IsEnabled="{Binding HasItems, ElementName=PurchasesList}">
                <Grid>
                    <TextBlock Text="Выберите покупку"
                               TextWrapping="Wrap" Margin="10" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=c:IslandPanel}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="{Binding RetailPlace, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}"
                                       Foreground="{DynamicResource Foreground.White}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RetailPlaceAddress, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}"/>
                            <c:MoneyAmount Display="{Binding Amount}" AmountAlignment="Left" Margin="0,3,0,0"
                                           FontWeight="SemiBold" AutomationProperties.Name="Итог чека"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="11,4,11,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemQuantity"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemPrice"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ItemTotal"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название"/>
                            <TextBlock Grid.Column="1" Text="Кол-во" Margin="12,0,0,0" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Цена" Margin="12,0,0,0" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Сумма" Margin="12,0,0,0" TextAlignment="Right"/>
                        </Grid>
                        <ListView Grid.Row="2" Style="{StaticResource BudgetList}" ItemsSource="{Binding Items}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Товары выбранной покупки">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Добавить товар" Click="AddPurchaseItem_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
                                    <EventSetter Event="ContextMenuOpening" Handler="PurchaseActionMenu_Opening"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="PurchaseItemRow_DoubleClick"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource PurchaseItemRowMenu}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ItemQuantity"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ItemPrice"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ItemTotal"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource BudgetEditedMarker}"/>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.###}}"
                                                   Margin="12,0,0,0" TextAlignment="Right"/>
                                        <c:MoneyAmount Grid.Column="2" Display="{Binding Price}" Margin="12,0,0,0"/>
                                        <c:MoneyAmount Grid.Column="3" Display="{Binding Sum}"
                                                       Margin="12,0,0,0" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </c:IslandPanel>
            <c:Loader x:Name="Progress" Grid.ColumnSpan="3"/>
        </Grid>
    </Grid>
</UserControl>
