<UserControl x:Class="Castar.Contents.PurchasesContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Castar.Compontents" Loaded="Purchases_Loaded" Unloaded="Purchases_Unloaded"
 IsVisibleChanged="Purchases_IsVisibleChanged" ContextMenuOpening="Purchases_ContextMenuOpening" FontFamily="Segoe UI" FontSize="14">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Castar;component/Styles/ExpenseLedger.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="PurchaseActionVisibility"/>
  <Style x:Key="ExpenseAmountWarning" TargetType="ContentControl">
   <Setter Property="Content" Value="{DynamicResource Svg.Warning}"/><Setter Property="Foreground" Value="{DynamicResource Warning.Svg.Brush}"/>
   <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
   <Style.Triggers><Trigger Property="ToolTip" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <ContextMenu x:Key="PurchaseRowMenu" Style="{StaticResource LedgerContextMenu}">
   <MenuItem Header="Редактировать" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.EditIcon}" Click="EditPurchaseMenu_Click" Visibility="{Binding CanDelete, Converter={StaticResource PurchaseActionVisibility}}"/>
   <MenuItem Header="Показать исходные данные" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.SourceIcon}" Click="ShowReceiptSource_Click" Visibility="{Binding HasReceiptSource, Converter={StaticResource PurchaseActionVisibility}}"/>
   <MenuItem Header="Удалить покупку" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.DeleteIcon}" Click="DeletePurchase_Click" Visibility="{Binding CanDelete, Converter={StaticResource PurchaseActionVisibility}}"/>
  </ContextMenu>
  <ContextMenu x:Key="PurchaseItemRowMenu" Style="{StaticResource LedgerContextMenu}"><MenuItem Header="Редактировать" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.EditIcon}" Click="EditPurchaseItemMenu_Click"/><MenuItem Header="Удалить товар" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.DeleteIcon}" Click="DeletePurchaseItem_Click"/></ContextMenu>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource LedgerCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="24,20,24,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{DynamicResource Svg.Menu.Purchases}" Foreground="{DynamicResource Highlight}" Width="30" Height="36" Margin="0,0,18,0"/><TextBlock Text="Расходы" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.White}"/></StackPanel>
   <Button x:Name="AddPurchaseButton" Grid.Column="1" Style="{StaticResource LedgerActionButton}" Background="{DynamicResource Highlight}" Foreground="{DynamicResource Main.Background.lvl1}" BorderBrush="{DynamicResource Highlight}" Click="AddPurchase_Click" AutomationProperties.Name="Добавить покупку"><StackPanel Orientation="Horizontal"><Path Data="M 0,7 L 14,7 M 7,0 L 7,14" Stroke="{DynamicResource Main.Background.lvl1}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Добавить покупку" FontWeight="SemiBold"/></StackPanel></Button>
  </Grid>
  <Border x:Name="ExpenseSummaryCard" Grid.Row="1" Style="{StaticResource ExpenseCardSurface}" Margin="24,0,24,20" Padding="20,18" CornerRadius="12">
   <StackPanel><TextBlock Text="Всего расходов" Foreground="{StaticResource LedgerMuted}" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="ExpenseTotal" Text="—" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.White}" AutomationProperties.Name="Сумма расходов за период"/><ContentControl x:Name="ExpenseTotalWarning" Style="{StaticResource ExpenseAmountWarning}"/></StackPanel></StackPanel>
  </Border>
  <WrapPanel x:Name="PeriodBar" Grid.Row="2" Margin="24,0,24,16">
   <Border Background="{StaticResource LedgerSurface}" BorderBrush="{StaticResource LedgerBorder}" BorderThickness="1" CornerRadius="6" Width="330" Margin="0" Padding="14,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Path Data="M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 15,15" Stroke="{StaticResource LedgerMuted}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
    <TextBox x:Name="PurchaseSearchBox" Grid.Column="1" TextChanged="PurchaseSearch_TextChanged" AutomationProperties.Name="Поиск по расходам" Background="Transparent" BorderThickness="0" Padding="4,8" MinHeight="38"/>
    <TextBlock x:Name="PurchaseSearchPlaceholder" Grid.Column="1" Text="Поиск по расходам…" Foreground="{StaticResource LedgerMuted}" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid></Border>  </WrapPanel>
  <TextBlock x:Name="StatusText" Grid.Row="3" Margin="24,0,24,12" Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
  <Grid x:Name="BudgetContent" Grid.Row="4" Margin="24,0,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <Grid>
    <ListView x:Name="PurchasesList" Style="{StaticResource BudgetList}" Background="Transparent" Padding="0" BorderThickness="0" SelectionMode="Single" SelectionChanged="PurchasesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Покупки за период">
     <ListView.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource LedgerScrollViewer}"/></ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ExpensePurchaseRow}"><EventSetter Event="MouseDoubleClick" Handler="PurchaseRow_DoubleClick"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <c:UserAvatar Width="30" Height="30" Margin="0,0,10,0" Photo="{Binding OwnerAvatar, Converter={StaticResource UserAvatarImageConverter}}" UserName="{Binding OwnerName}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><DockPanel><TextBlock Style="{StaticResource BudgetEditedMarker}"/><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.White}"/></DockPanel><TextBlock Foreground="{StaticResource LedgerMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1:dd.MM.yyyy HH:mm}"><Binding Path="OwnerName"/><Binding Path="AddedOn"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"><c:MoneyAmount Display="{Binding Amount}" Foreground="{StaticResource LedgerExpense}" FontWeight="SemiBold" FontSize="14"/><ContentControl Style="{StaticResource ExpenseAmountWarning}" ToolTip="{Binding AmountWarning}"/></StackPanel>
       <Button x:Name="PurchaseActionsButton" Grid.Column="3" Tag="{Binding}" Style="{StaticResource ExpenseRowActions}" Click="PurchaseActions_Click" AutomationProperties.Name="Действия с покупкой" ContextMenu="{StaticResource PurchaseRowMenu}"><Canvas Width="18" Height="4"><Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/><Ellipse Canvas.Left="7" Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/><Ellipse Canvas.Left="14" Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/></Canvas></Button>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock x:Name="EmptyPurchases" Text="Нет покупок" Margin="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource LedgerMuted}" Visibility="Collapsed"/>
   </Grid>
   <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource ExpenseCardSurface}" Padding="18,16">
    <Grid Grid.IsSharedSizeScope="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Товары" Style="{StaticResource ExpenseSectionTitle}" VerticalAlignment="Center"/><Button x:Name="AddPurchaseItemButton" Grid.Column="1" Style="{StaticResource LedgerActionButton}" Content="Добавить товар" Click="AddPurchaseItem_Click" AutomationProperties.Name="Добавить товар" IsEnabled="{Binding CanDelete, FallbackValue=False}"/></Grid>
     <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="{Binding RetailPlace, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}" Foreground="{DynamicResource Foreground.White}" FontWeight="SemiBold"/><TextBlock Text="{Binding RetailPlaceAddress, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}" Foreground="{StaticResource LedgerMuted}"/><c:MoneyAmount Display="{Binding Amount}" AmountAlignment="Left" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{StaticResource LedgerExpense}" FontSize="18" AutomationProperties.Name="Итог чека"/><TextBlock Text="{Binding Tag.Message, ElementName=DetailsPanel}" Style="{StaticResource BudgetOptionalText}" Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
     <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="ExpenseItemQuantity"/><ColumnDefinition Width="Auto" MinWidth="74" SharedSizeGroup="ExpenseItemPrice"/><ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="ExpenseItemSum"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="Название" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="1" Text="Кол-во" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="2" Text="Цена" Margin="14,0,0,0" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="3" Text="Сумма" Margin="14,0,0,0" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/></Grid>
     <ListView x:Name="ItemsList" Grid.Row="3" FontSize="14" Style="{StaticResource BudgetList}" Background="Transparent" Padding="0" BorderThickness="0" ItemsSource="{Binding Items}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Товары выбранной покупки">
      <ListView.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource LedgerScrollViewer}"/></ListView.Resources>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ExpenseItemRow}"><EventSetter Event="MouseDoubleClick" Handler="PurchaseItemRow_DoubleClick"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="ExpenseItemQuantity"/><ColumnDefinition Width="Auto" MinWidth="74" SharedSizeGroup="ExpenseItemPrice"/><ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="ExpenseItemSum"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <DockPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource BudgetEditedMarker}"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Foreground.White}"/></DockPanel>
       <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.###}}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource LedgerMuted}"/>
       <c:MoneyAmount Grid.Column="2" Display="{Binding Price}" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
       <c:MoneyAmount Grid.Column="3" Display="{Binding Sum}" FontSize="14" Margin="16,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource LedgerExpense}" VerticalAlignment="Center"/>
       <Button x:Name="ItemActionsButton" Grid.Column="4" Tag="{Binding}" Style="{StaticResource ExpenseRowActions}" Click="PurchaseActions_Click" ContextMenu="{StaticResource PurchaseItemRowMenu}" AutomationProperties.Name="Действия с товаром"><Canvas Width="18" Height="4"><Ellipse Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/><Ellipse Canvas.Left="7" Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/><Ellipse Canvas.Left="14" Width="4" Height="4" Fill="{DynamicResource Foreground.White}"/></Canvas></Button>
      </Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <TextBlock x:Name="EmptyItems" Grid.Row="1" Grid.RowSpan="3" Text="Выберите покупку" Foreground="{StaticResource LedgerMuted}" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <c:Loader Grid.Row="3" IsLoading="{Binding Tag.IsLoading, ElementName=DetailsPanel, FallbackValue=False}"/>
    </Grid>
   </Border>
   <c:Loader x:Name="Progress" Grid.ColumnSpan="3"/>
  </Grid>
 </Grid>
</UserControl>
