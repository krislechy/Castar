<UserControl x:Class="Castar.Contents.PurchasesContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:api="clr-namespace:Castar.Api;assembly=Castar.Api"
 xmlns:c="clr-namespace:Castar.Compontents" xmlns:views="clr-namespace:Castar.Contents"
 Loaded="Purchases_Loaded" Unloaded="Purchases_Unloaded"
 IsVisibleChanged="Purchases_IsVisibleChanged" ContextMenuOpening="Purchases_ContextMenuOpening" FontFamily="Segoe UI" FontSize="14">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Castar;component/Styles/ExpenseLedger.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="PurchaseActionVisibility"/>
  <c:BudgetCategoryIconConverter x:Key="CategoryIcon"/>
  <Style x:Key="ExpenseCategoryStatusIcon" TargetType="Path">
   <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
   <Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="StrokeThickness" Value="1.4"/><Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
  <Style x:Key="ExpenseAmountWarning" TargetType="ContentControl">
   <Setter Property="Content" Value="{DynamicResource Svg.Warning}"/><Setter Property="Foreground" Value="{DynamicResource Warning.Svg.Brush}"/>
   <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
   <Style.Triggers><Trigger Property="ToolTip" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <ContextMenu x:Key="PurchaseRowMenu" Style="{StaticResource LedgerContextMenu}">
   <MenuItem Header="Редактировать" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.EditIcon}" Click="EditPurchaseMenu_Click" Visibility="{Binding CanDelete, Converter={StaticResource PurchaseActionVisibility}}"/>
   <MenuItem Header="Показать исходные данные" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.SourceIcon}" Click="ShowReceiptSource_Click" Visibility="{Binding HasReceiptSource, Converter={StaticResource PurchaseActionVisibility}}"/>
   <MenuItem Header="Удалить покупку" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.DeleteIcon}" Click="DeletePurchase_Click" Visibility="{Binding CanDelete, Converter={StaticResource PurchaseActionVisibility}}"/>
  </ContextMenu>
  <ContextMenu x:Key="PurchaseItemRowMenu" Style="{StaticResource LedgerContextMenu}"><MenuItem Header="Редактировать" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.EditIcon}" Click="EditPurchaseItemMenu_Click"/><MenuItem Header="Удалить товар" Style="{StaticResource LedgerMenuItem}" Icon="{StaticResource Ledger.DeleteIcon}" Click="DeletePurchaseItem_Click"/></ContextMenu>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{StaticResource LedgerCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border x:Name="ExpenseSummaryCard" Style="{StaticResource ExpenseCardSurface}" Margin="24,20,24,20" Padding="20,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ContentControl Style="{StaticResource LedgerSummaryIcon}">
     <ContentControl Content="{StaticResource Svg.Menu.Purchases}" Width="40" Height="40"/>
    </ContentControl>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
     <TextBlock Text="Всего расходов" Foreground="{StaticResource LedgerMuted}" Margin="0,0,0,4"/>
     <Grid HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="44">
       <TextBlock x:Name="ExpenseTotal" Text="—" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.White}" AutomationProperties.Name="Сумма расходов за период"/>
      </Viewbox>
      <ContentControl x:Name="ExpenseTotalWarning" Grid.Column="1" Style="{StaticResource ExpenseAmountWarning}"/>
     </Grid>
    </StackPanel>
    <ContentControl x:Name="ExpenseComparison" Grid.Column="2" Style="{StaticResource LedgerPeriodComparison}"/>
   </Grid>
  </Border>
  <DockPanel Grid.Row="1" Margin="24,0,24,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
    <c:PeriodClassificationButton x:Name="ClassificationButton"/>
    <c:CategorySettingsButton x:Name="CategorySettingsButton" Style="{StaticResource LedgerCategorySettingsButton}" Kind="{x:Static api:BudgetEvents.Purchase}"/>
    <Button Style="{StaticResource LedgerActionButton}" Click="RecurringPurchases_Click" AutomationProperties.Name="Подписки"
            MinHeight="44" Padding="12,8" Margin="0,0,8,0">
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource Lucide.repeat}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
            Stroke="{DynamicResource Castar.Accent}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            StrokeLineJoin="Round" VerticalAlignment="Center"/>
      <TextBlock Text="Подписки" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button x:Name="AddPurchaseButton" Style="{StaticResource LedgerPrimaryActionButton}"
     Click="AddPurchase_Click" AutomationProperties.Name="Добавить покупку" MinHeight="44">
     <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Lucide.plus}" Stretch="Uniform" Stroke="{Binding Foreground, ElementName=AddPurchaseButton}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Добавить покупку" FontWeight="SemiBold"/></StackPanel>
    </Button>
   </StackPanel>
   <WrapPanel x:Name="PeriodBar" Margin="0,0,12,0" VerticalAlignment="Center">
    <Border Style="{StaticResource LedgerSearchSurface}" Width="330" Margin="0,0,12,4" Padding="14,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Path Data="{StaticResource Lucide.search}" Stroke="{StaticResource LedgerMuted}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
    <TextBox x:Name="PurchaseSearchBox" Grid.Column="1" TextChanged="PurchaseSearch_TextChanged" AutomationProperties.Name="Поиск по расходам" Background="Transparent" BorderThickness="0" Padding="4,8" MinHeight="38"/>
    <TextBlock x:Name="PurchaseSearchPlaceholder" Grid.Column="1" Text="Поиск по расходам…" Foreground="{StaticResource LedgerMuted}" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Button x:Name="ClearPurchaseSearchButton" Grid.Column="2" Style="{StaticResource LedgerSearchClearButton}"
            Tag="{Binding Text, ElementName=PurchaseSearchBox}" Click="ClearPurchaseSearch_Click"/>
    </Grid></Border>
    <Button x:Name="UncategorizedFilterButton" Style="{StaticResource LedgerActionButton}" Margin="0,0,8,4"
            Visibility="Collapsed" Click="ClearUncategorizedFilter_Click" AutomationProperties.Name="Сбросить фильтр Без категории">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="Без категории" VerticalAlignment="Center"/>
      <Path Data="{StaticResource Lucide.x}" Width="12" Height="12" Margin="8,0,0,0" Stretch="Uniform"
            Stroke="{Binding Foreground, ElementName=UncategorizedFilterButton}" StrokeThickness="1.5"/>
     </StackPanel>
    </Button>
    <Border x:Name="SelectionTotal" Style="{StaticResource LedgerSelectionTotal}" Margin="0,0,0,4">
     <TextBlock x:Name="SelectionTotalText" Style="{StaticResource LedgerSelectionTotalText}"/>
    </Border>
   </WrapPanel>
  </DockPanel>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,0,24,12" Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
  <Grid x:Name="BudgetContent" Grid.Row="3" Margin="24,0,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <Grid>
    <ListView x:Name="PurchasesList" Style="{StaticResource BudgetList}" Background="Transparent" Padding="0" BorderThickness="0" SelectionMode="Extended" SelectionChanged="PurchasesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Покупки за период">
     <ListView.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource LedgerScrollViewer}"/></ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ExpensePurchaseDayRow}"><EventSetter Event="MouseDoubleClick" Handler="PurchaseRow_DoubleClick"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <c:UserAvatar Width="30" Height="30" Margin="0,0,10,0" Photo="{Binding OwnerAvatar, Converter={StaticResource UserAvatarImageConverter}}" UserName="{Binding OwnerName}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><DockPanel><Path Style="{StaticResource BudgetEditedMarker}"/><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.White}"/></DockPanel><TextBlock Foreground="{StaticResource LedgerMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1:dd.MM.yyyy HH:mm}"><Binding Path="OwnerName"/><Binding Path="AddedOn"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"><c:MoneyAmount Display="{Binding Amount}" Foreground="{StaticResource LedgerExpense}" FontWeight="SemiBold" FontSize="14"/><ContentControl Style="{StaticResource ExpenseAmountWarning}" ToolTip="{Binding AmountWarning}"/></StackPanel>
       <Button x:Name="PurchaseActionsButton" Grid.Column="3" Tag="{Binding}" Style="{StaticResource ExpenseRowActions}" Click="PurchaseActions_Click" AutomationProperties.Name="Действия с покупкой" ContextMenu="{StaticResource PurchaseRowMenu}"><Path Data="{StaticResource Lucide.ellipsis}" Width="18" Height="6" Stretch="Uniform" Stroke="{DynamicResource Foreground.White}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock x:Name="EmptyPurchases" Text="Нет покупок" Margin="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource LedgerMuted}" Visibility="Collapsed"/>
   </Grid>
   <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource ExpenseCardSurface}" Padding="18,16">
    <Grid Grid.IsSharedSizeScope="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Товары" Style="{StaticResource ExpenseSectionTitle}" VerticalAlignment="Center"/>
      <StackPanel x:Name="UncategorizedItemsWarning" Grid.Column="1" Orientation="Horizontal" Margin="8,0,10,0"
                  VerticalAlignment="Center" Background="Transparent" ToolTip="Товары без категории">
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Style.Triggers>
          <DataTrigger Binding="{Binding UncategorizedItemCount, FallbackValue=0}" Value="0">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <ContentControl Content="{DynamicResource Svg.Warning}" VerticalAlignment="Center"/>
       <TextBlock x:Name="UncategorizedItemsCount" Text="{Binding UncategorizedItemCount}" Margin="4,0,0,0"
                  Foreground="{DynamicResource Warning.Svg.Brush}" FontWeight="SemiBold" VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding UncategorizedItemCount, StringFormat='Товары без категории: {0}'}"/>
      </StackPanel>
      <c:PeriodClassificationButton x:Name="ReclassifyPurchaseButton" Grid.Column="2"
              MinWidth="40" MinHeight="40" Padding="8" Click="ReclassifyPurchase_Click"
              Content="Повторить категоризацию покупки" AutomationProperties.Name="Повторить категоризацию покупки"
              AutomationProperties.HelpText="" ToolTipService.ShowOnDisabled="True"/>
      <Grid x:Name="PurchaseItemQueueStatus" Grid.Column="3" Width="68" Margin="0,0,8,0" VerticalAlignment="Center">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.Style>
        <Style TargetType="Grid">
         <Style.Triggers>
          <DataTrigger Binding="{Binding PendingPurchaseItemCount, RelativeSource={RelativeSource AncestorType=views:PurchasesContent}, FallbackValue=0}" Value="0">
           <Setter Property="Visibility" Value="Hidden"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Grid.Style>
       <Button x:Name="RetryPurchaseItemsButton" Padding="8" Click="RetryPendingPurchaseItems_Click"
               ToolTip="{Binding PurchaseItemQueueMessage, RelativeSource={RelativeSource AncestorType=views:PurchasesContent}}"
               AutomationProperties.ItemStatus="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
               ToolTipService.ShowOnDisabled="True">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource LedgerActionButton}">
          <Setter Property="Foreground" Value="{DynamicResource Warning.Svg.Brush}"/>
          <Setter Property="AutomationProperties.Name" Value="Повторить отправку товаров"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsPurchaseItemQueueWaiting, RelativeSource={RelativeSource AncestorType=views:PurchasesContent}, FallbackValue=False}" Value="True">
            <Setter Property="c:ButtonLoading.IsBusy" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
            <Setter Property="AutomationProperties.Name" Value="Товары ожидают отправки"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
        <Path Style="{StaticResource ExpenseCategoryStatusIcon}" Data="{StaticResource Lucide.rotate-ccw}"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
       </Button>
       <TextBlock x:Name="PendingPurchaseItemsCount" Grid.Column="1" Margin="4,0,0,0"
                  Text="{Binding PendingPurchaseItemCount, RelativeSource={RelativeSource AncestorType=views:PurchasesContent}}"
                  Foreground="{Binding Foreground, ElementName=RetryPurchaseItemsButton}"
                  FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding ToolTip, ElementName=RetryPurchaseItemsButton}"
                  AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Товаров в очереди: {0}'}"
                  AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <Button x:Name="AddPurchaseItemButton" Grid.Column="4" Style="{StaticResource LedgerActionButton}" Content="Добавить товар"
              Click="AddPurchaseItem_Click" AutomationProperties.Name="Добавить товар" IsEnabled="{Binding CanDelete, FallbackValue=False}"/>
     </Grid>
     <StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="{Binding RetailPlace, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}" Foreground="{DynamicResource Foreground.White}" FontWeight="SemiBold"/><TextBlock Text="{Binding RetailPlaceAddress, TargetNullValue=''}" Style="{StaticResource BudgetOptionalText}" Foreground="{StaticResource LedgerMuted}"/><c:MoneyAmount Display="{Binding Amount}" AmountAlignment="Left" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{StaticResource LedgerExpense}" FontSize="18" AutomationProperties.Name="Итог чека"/><TextBlock Text="{Binding Tag.Message, ElementName=DetailsPanel}" Style="{StaticResource BudgetOptionalText}" Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
     <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="ExpenseItemQuantity"/><ColumnDefinition Width="Auto" MinWidth="74" SharedSizeGroup="ExpenseItemPrice"/><ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="ExpenseItemSum"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="Название" Margin="8,0,0,0" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="1" Text="Кол-во" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="2" Text="Цена" Margin="14,0,0,0" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/><TextBlock Grid.Column="3" Text="Сумма" Margin="14,0,0,0" TextAlignment="Right" Foreground="{StaticResource LedgerMuted}"/></Grid>
     <ListView x:Name="ItemsList" Grid.Row="3" FontSize="14" Style="{StaticResource BudgetList}" Background="Transparent" Padding="0" BorderThickness="0" ItemsSource="{Binding Items}" SelectionMode="Extended" SelectionChanged="ItemsSelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Товары выбранной покупки">
      <ListView.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource LedgerScrollViewer}"/></ListView.Resources>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ExpenseItemRow}"><EventSetter Event="MouseDoubleClick" Handler="PurchaseItemRow_DoubleClick"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="ExpenseItemQuantity"/><ColumnDefinition Width="Auto" MinWidth="74" SharedSizeGroup="ExpenseItemPrice"/><ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="ExpenseItemSum"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <DockPanel VerticalAlignment="Center">
        <DockPanel.Style>
         <Style TargetType="DockPanel">
          <Setter Property="MinHeight" Value="35"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding HasCategory}" Value="False"><Setter Property="MinHeight" Value="0"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </DockPanel.Style>
        <Path Style="{StaticResource BudgetEditedMarker}"/>
        <Border x:Name="ItemCategorySlot" DockPanel.Dock="Left" Background="Transparent"
                Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="{Binding CategoryLabel}"
                AutomationProperties.Name="{Binding CategoryLabel}">
         <Grid Width="16" Height="16">
          <ContentControl Content="{DynamicResource Svg.Warning}">
           <ContentControl.Style>
            <Style TargetType="ContentControl">
             <Style.Triggers>
              <DataTrigger Binding="{Binding HasCategory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </ContentControl.Style>
          </ContentControl>
          <Path x:Name="ItemCategoryGlyph" Data="{Binding CategoryIconKey, Converter={StaticResource CategoryIcon}}"
                Stroke="{StaticResource LedgerMuted}"
                Visibility="{Binding HasCategory, Converter={StaticResource PurchaseActionVisibility}}">
           <Path.Style>
            <Style TargetType="Path" BasedOn="{StaticResource ExpenseCategoryStatusIcon}">
             <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
           </Path.Style>
          </Path>
         </Grid>
        </Border>
        <TextBlock x:Name="ItemNameText" Text="{Binding Name}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Foreground.White}"/>
       </DockPanel>
       <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.###}}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource LedgerMuted}"/>
       <c:MoneyAmount Grid.Column="2" Display="{Binding Price}" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
       <c:MoneyAmount Grid.Column="3" Display="{Binding Sum}" FontSize="14" Margin="16,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource LedgerExpense}" VerticalAlignment="Center"/>
       <Button x:Name="ItemActionsButton" Grid.Column="4" Tag="{Binding}" Style="{StaticResource ExpenseRowActions}" Click="PurchaseActions_Click" ContextMenu="{StaticResource PurchaseItemRowMenu}" AutomationProperties.Name="Действия с товаром"><Path Data="{StaticResource Lucide.ellipsis}" Width="18" Height="6" Stretch="Uniform" Stroke="{DynamicResource Foreground.White}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      </Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Border x:Name="GoodsSelectionTotal" Grid.Row="4" Style="{StaticResource LedgerSelectionTotal}" HorizontalAlignment="Right" Margin="0,8,0,0">
      <TextBlock x:Name="GoodsSelectionTotalText" Style="{StaticResource LedgerSelectionTotalText}"/>
     </Border>
     <TextBlock x:Name="EmptyItems" Grid.Row="1" Grid.RowSpan="3" Text="Выберите покупку" Foreground="{StaticResource LedgerMuted}" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <c:Loader Grid.Row="3" IsLoading="{Binding Tag.IsLoading, ElementName=DetailsPanel, FallbackValue=False}"/>
    </Grid>
   </Border>
   <c:Loader x:Name="Progress" Grid.ColumnSpan="3"/>
  </Grid>
 </Grid>
</UserControl>
