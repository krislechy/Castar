<UserControl x:Class="Castar.Contents.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             xmlns:local="clr-namespace:Castar.Contents"
             xmlns:converters="clr-namespace:Castar.Converters"
             xmlns:settings="clr-namespace:Castar.Settings"
             Name="Настройки" Loaded="Settings_Loaded" Unloaded="Settings_Unloaded"
             IsVisibleChanged="Settings_IsVisibleChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ServerConnectionVisibility"/>
        <converters:SexConverter x:Key="UserSex"/>
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="6,3"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="c:IslandPanel">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="BackToSections" Content="Назад" Click="BackToSections_Click"
                    Visibility="Collapsed" DockPanel.Dock="Left" VerticalAlignment="Center"
                    Style="{StaticResource SettingsSectionButton}"/>
            <c:IslandPanel x:Name="SettingsTitle" IsMainTitle="True" Title="Настройки"/>
        </DockPanel>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="SectionMenu" HorizontalAlignment="Left" Width="342">
                    <Button Content="{Binding Title, ElementName=ConnectionSection}" Tag="{Binding ElementName=ConnectionSection}"
                            Style="{StaticResource SettingsSectionButton}" Click="OpenSettingsSection_Click"/>
                    <Button Content="{Binding Title, ElementName=ServerSection}" Tag="{Binding ElementName=ServerSection}"
                            Visibility="{Binding ServerConfiguration.HasConnection, Converter={StaticResource ServerConnectionVisibility}}"
                            Style="{StaticResource SettingsSectionButton}" Click="OpenSettingsSection_Click"/>
                    <Button Content="{Binding Title, ElementName=ApplicationSection}" Tag="{Binding ElementName=ApplicationSection}"
                            Style="{StaticResource SettingsSectionButton}" Click="OpenSettingsSection_Click"/>
                    <Button Content="{Binding Title, ElementName=UsersSection}" Tag="{Binding ElementName=UsersSection}"
                            Visibility="{Binding UsersAvailable, Converter={StaticResource ServerConnectionVisibility}}"
                            Style="{StaticResource SettingsSectionButton}" Click="OpenSettingsSection_Click"/>
                    <Button Content="{Binding Title, ElementName=UpdatesSection}" Tag="{Binding ElementName=UpdatesSection}"
                            Style="{StaticResource SettingsSectionButton}" Click="OpenSettingsSection_Click"/>
                </StackPanel>
                <Grid Visibility="Collapsed">
                <c:IslandPanel x:Name="ConnectionSection" Title="Подключение" Style="{StaticResource SettingsCard}"
                               ImageSvg="{DynamicResource Svg.DataBase}">
                    <StackPanel Width="330">
                        <TextBlock Text="Адрес сервера" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox AutomationProperties.Name="Адрес сервера"
                                 Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ключ API" Style="{StaticResource FormFieldLabel}"/>
                        <PasswordBox AutomationProperties.Name="Ключ API" PasswordChanged="ApiKey_PasswordChanged"/>
                        <Button Content="Подключиться" Style="{StaticResource FormAction}"
                                Click="SaveServerConnection_Click"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource ViewStatus}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </c:IslandPanel>
                </Grid>
                <Grid Visibility="Collapsed">
                <c:IslandPanel x:Name="ServerSection" Title="Сервер" Style="{StaticResource SettingsCard}" ImageSvg="{DynamicResource Svg.DataBase}"
                               IsVisibleChanged="SettingsSection_IsVisibleChanged"
                               DataContext="{Binding ServerConfiguration}"
                               Visibility="{Binding HasConnection, Converter={StaticResource ServerConnectionVisibility}}">
                    <StackPanel Width="330">
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <CheckBox Content="Telegram-бот" IsChecked="{Binding TelegramEnabled}"
                                      IsEnabled="{Binding CanEditTelegram}"/>
                            <TextBlock Text="{Binding TelegramStatus}" Style="{StaticResource ViewStatus}"/>
                            <StackPanel Visibility="{Binding SupportsCredentials, Converter={StaticResource ServerConnectionVisibility}}">
                                <TextBlock Text="Токен Telegram" Style="{StaticResource FormFieldLabel}"/>
                                <PasswordBox AutomationProperties.Name="Токен Telegram" PasswordChanged="TelegramToken_PasswordChanged"/>
                            </StackPanel>
                            <CheckBox Content="Обработка чеков" IsChecked="{Binding ReceiptsEnabled}"/>
                            <Button Content="Настройки Telegram" Click="ConfigureTelegramPreferences_Click"
                                    Style="{StaticResource FormAction}" IsEnabled="{Binding CanEdit}"
                                    Visibility="{Binding SupportsTelegramPreferences, Converter={StaticResource ServerConnectionVisibility}}"/>
                            <TextBlock Text="Поставщик чеков" Style="{StaticResource FormFieldLabel}"/>
                            <c:CastarComboBox ItemsSource="{Binding ReceiptProviders}" DisplayMemberPath="Label"
                                              SelectedValuePath="Id" SelectedValue="{Binding ReceiptProvider}"
                                              AutomationProperties.Name="Поставщик чеков"/>
                            <CheckBox Content="Анонимная авторизация" IsChecked="{Binding UseAnonymous, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChooseAuthentication}"
                                      Visibility="{Binding HasAuthenticationProfile, Converter={StaticResource ServerConnectionVisibility}}"/>
                            <Button Content="Установить данные для входа" Style="{StaticResource FormAction}"
                                    Click="ConfigureReceiptCredentials_Click"
                                    Visibility="{Binding ShowReceiptCredentials, Converter={StaticResource ServerConnectionVisibility}}"/>
                            <StackPanel Visibility="{Binding SupportsManualCurrency, Converter={StaticResource ServerConnectionVisibility}}">
                                <TextBlock Text="{Binding ManualCurrency.DefaultCurrency, StringFormat='Валюта ручного добавления — {0}'}"
                                           Style="{StaticResource FormFieldLabel}"/>
                                <Button Content="Настроить валюты" Style="{StaticResource FormAction}"
                                        Click="ConfigureManualCurrencies_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить" Style="{StaticResource FormAction}"
                                    IsEnabled="{Binding CanSave}" Click="SaveServerSettings_Click"
                                    AutomationProperties.Name="Сохранить настройки сервера"/>
                            <Button Content="Обновить" Style="{StaticResource FormAction}"
                                    Margin="8,8,0,0" IsEnabled="{Binding CanReload}" Click="ReloadServerSettings_Click"
                                    AutomationProperties.Name="Обновить настройки сервера"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource ViewStatus}"/>
                        <Button Content="{Binding BackupActionLabel}" Style="{StaticResource FormAction}"
                                Click="CreateDatabaseBackup_Click"/>
                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource ViewStatus}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel DataContext="{Binding Updates}">
                            <Button Content="Обновить сервер" Style="{StaticResource FormAction}"
                                    IsEnabled="{Binding CanStart}" Click="UpdateServer_Click"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource ViewStatus}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                         Visibility="{Binding IsWorking, Converter={StaticResource ServerConnectionVisibility}}"
                                         AutomationProperties.Name="Ход обновления сервера"/>
                        </StackPanel>
                    </StackPanel>
                </c:IslandPanel>
                </Grid>
                <Grid Visibility="Collapsed">
                <c:IslandPanel x:Name="ApplicationSection" Title="Приложение" Style="{StaticResource SettingsCard}" ImageSvg="{DynamicResource Svg.Tools}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Settings.IsHideInTray}" Content="При закрытии сворачивать в трей"/>
                        <CheckBox IsChecked="{Binding Settings.IsAutoRun}" Content="Запускать с Windows"/>
                        <TextBlock Text="Отображаемая валюта" Style="{StaticResource FormFieldLabel}"/>
                        <c:CastarComboBox ItemsSource="{Binding CurrencyOptions}" DisplayMemberPath="Label" SelectedValuePath="Code"
                                          SelectedValue="{Binding Settings.DisplayCurrency, Mode=TwoWay}"
                                          AutomationProperties.Name="Отображаемая валюта"/>
                        <TextBlock Text="Часовой пояс" Style="{StaticResource FormFieldLabel}"/>
                        <c:CastarComboBox ItemsSource="{Binding Settings.DisplayTimeZones}" DisplayMemberPath="Label"
                                          SelectedValuePath="Id" SelectedValue="{Binding Settings.DisplayTimeZoneId, Mode=TwoWay}"
                                          AutomationProperties.Name="Часовой пояс"/>
                        <TextBlock Text="Уведомления" Style="{StaticResource FormFieldLabel}"/>
                        <c:CastarComboBox ItemsSource="{Binding NotificationModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.NotificationMode, Mode=TwoWay}"
                                          AutomationProperties.Name="Уведомления"/>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.NotificationMode}" Value="{x:Static settings:NotificationMode.Castar}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Расположение" Style="{StaticResource FormFieldLabel}"/>
                            <c:CastarComboBox ItemsSource="{Binding NotificationCorners}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.NotificationCorner, Mode=TwoWay}"
                                              AutomationProperties.Name="Расположение уведомлений"/>
                            <TextBlock Text="Количество уведомлений" Style="{StaticResource FormFieldLabel}"/>
                            <c:CastarComboBox ItemsSource="{Binding NotificationCounts}"
                                              SelectedItem="{Binding Settings.MaxVisibleNotifications, Mode=TwoWay}"
                                              AutomationProperties.Name="Количество уведомлений"/>
                        </StackPanel>
                    </StackPanel>
                </c:IslandPanel>
                </Grid>
                <Grid Visibility="Collapsed">
                <c:IslandPanel x:Name="UsersSection" Title="Пользователи" Style="{StaticResource SettingsCard}" ImageSvg="{DynamicResource Svg.Users}"
                               IsVisibleChanged="SettingsSection_IsVisibleChanged"
                               Visibility="{Binding UsersAvailable, Converter={StaticResource ServerConnectionVisibility}}">
                    <StackPanel Width="330">
                        <UniformGrid Columns="3" Margin="7,0,7,0">
                            <TextBlock Text="Имя" Style="{StaticResource BudgetTableHeader}"/>
                            <TextBlock Text="Telegram ID" Style="{StaticResource BudgetTableHeader}"/>
                            <TextBlock Text="Пол" Style="{StaticResource BudgetTableHeader}"/>
                        </UniformGrid>
                        <ListView Style="{StaticResource BudgetList}" MaxHeight="250" SelectionMode="Single"
                                  AutomationProperties.Name="Пользователи" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemsSource="{Binding Users}" MouseDoubleClick="UsersListView_MouseDoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Удалить" AutomationProperties.Name="Удалить пользователя"
                                              Icon="{StaticResource Svg.Remove}" Click="DeleteUserButton_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <UniformGrid Columns="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <c:UserAvatar Width="24" Height="24" Margin="0,0,3,0" VerticalAlignment="Center"
                                                          UserName="{Binding Name}"
                                                          Photo="{Binding ImageRaw, Converter={StaticResource UserAvatarImageConverter}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BudgetTableCell}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TelegramId}" Style="{StaticResource BudgetTableCell}"/>
                                        <TextBlock Text="{Binding Sex, Converter={StaticResource UserSex}}"
                                                   Style="{StaticResource BudgetTableCell}"/>
                                    </UniformGrid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Добавить" AutomationProperties.Name="Добавить пользователя"
                                Style="{StaticResource FormAction}" Click="NewUserButton_Click"/>
                    </StackPanel>
                </c:IslandPanel>
                </Grid>
                <Grid Visibility="Collapsed">
                <c:IslandPanel x:Name="UpdatesSection" Title="Обновления" Style="{StaticResource SettingsCard}" ImageSvg="{DynamicResource Svg.Tools}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource ViewStatus}"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                     AutomationProperties.Name="Ход загрузки обновления">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Button Content="Проверить" AutomationProperties.Name="Проверить обновления"
                                Style="{StaticResource FormAction}" Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </c:IslandPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
