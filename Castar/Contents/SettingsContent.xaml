<UserControl x:Class="Castar.Contents.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             Name="Настройки" Loaded="Settings_Loaded" Unloaded="Settings_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <c:IslandPanel IsMainTitle="True" Title="Настройки"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <c:IslandPanel Title="Подключение к Castar Server" ImageSvg="{DynamicResource Svg.DataBase}">
                    <StackPanel Width="330">
                        <TextBlock Text="Адрес сервера" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox AutomationProperties.Name="Адрес сервера"
                                 Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ключ API" Style="{StaticResource FormFieldLabel}"/>
                        <PasswordBox AutomationProperties.Name="Ключ API" PasswordChanged="ApiKey_PasswordChanged"/>
                        <Button Content="Проверить и сохранить" Style="{StaticResource FormAction}"
                                Click="SaveServerConnection_Click"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource ViewStatus}"/>
                    </StackPanel>
                </c:IslandPanel>
                <c:IslandPanel Title="Параметры клиента" ImageSvg="{DynamicResource Svg.Tools}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Settings.IsHideInTray}" Content="При закрытии сворачивать в трей"/>
                        <CheckBox IsChecked="{Binding Settings.IsAutoRun}" Content="Запускать вместе с Windows"/>
                    </StackPanel>
                </c:IslandPanel>
                    <c:IslandPanel Title="Пользователи" ImageSvg="{DynamicResource Svg.Users}">
                        <StackPanel>
                            <TextBlock Text="{Binding UsersStatus}" Style="{StaticResource ViewStatus}"/>
                            <ListView Style="{StaticResource BudgetList}" ItemContainerStyle="{StaticResource BudgetListItem}"
                                      MaxHeight="250" SelectionMode="Single"
                                      ItemsSource="{Binding Users,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      MouseDoubleClick="UsersListView_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Удалить пользователя" Icon="{StaticResource Svg.Remove}"
                                                  Click="DeleteUserButton_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <c:UserInfoPanel HorizontalContentAlignment="Stretch" DataContext="{Binding}" SizeImage="55"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Добавить пользователя" Style="{StaticResource FormAction}" Click="NewUserButton_Click"/>
                        </StackPanel>
                    </c:IslandPanel>
                <c:IslandPanel Title="Обновления Castar" ImageSvg="{DynamicResource Svg.Tools}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource ViewStatus}"/>
                        <Button Content="Проверить обновления" Style="{StaticResource FormAction}" Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </c:IslandPanel>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
