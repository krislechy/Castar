<UserControl x:Class="Castar.Contents.StatisticsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             Loaded="Statistics_Loaded" Unloaded="Statistics_Unloaded"
             IsVisibleChanged="Statistics_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BudgetHeaderSurface}">
          <WrapPanel x:Name="PeriodBar" Style="{StaticResource BudgetPeriodBar}">
            <TextBlock Text="Статистика" Style="{StaticResource BudgetHeaderTitle}"/>
            <c:SelectorRangeDates x:Name="Dates" VerticalAlignment="Center"
                                  DateRangeChanged="Dates_DateRangeChanged"/>
            <c:CastarComboBox x:Name="CurrencyPicker" MinWidth="88" Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" AutomationProperties.Name="Валюта статистики"
                              SelectionChanged="CurrencyPicker_SelectionChanged"/>
          </WrapPanel>
        </Border>
        <TextBlock x:Name="MissingAmounts" Grid.Row="1" Margin="{StaticResource BudgetStatusMargin}"
                   Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        <Grid x:Name="BudgetContent" Grid.Row="2" Margin="{StaticResource BudgetContentMargin}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="16"
                       Foreground="{DynamicResource Foreground.Gray}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <Grid x:Name="Dashboard" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <ItemsControl x:Name="Totals" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="12,8" CornerRadius="5"
                                    Background="{DynamicResource Main.Background.lvl1}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource GrayTextBlock}"/>
                                    <TextBlock Text="{Binding Amount}" FontSize="20" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Foreground.White}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Grid.Row="1">
                    <c:IslandPanel x:Name="CategoriesPanel" DockPanel.Dock="Right" Width="320"
                                   Title="Расходы по категориям" Visibility="Collapsed"/>
                    <c:IslandPanel x:Name="TimelinePanel" Title="Динамика за период"/>
                </DockPanel>
            </Grid>
            <c:Loader x:Name="Progress"/>
        </Grid>
    </Grid>
</UserControl>
