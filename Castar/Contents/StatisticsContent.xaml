<UserControl x:Class="Castar.Contents.StatisticsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             xmlns:local="clr-namespace:Castar.Contents"
             FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
             Loaded="Statistics_Loaded" Unloaded="Statistics_Unloaded"
             IsVisibleChanged="Statistics_IsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Castar;component/Styles/LedgerCards.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StatisticsChartSurface" TargetType="Border" BasedOn="{StaticResource Castar.Panel}">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="StatisticsChartTitle" TargetType="TextBlock" BasedOn="{StaticResource BudgetHeaderTitle}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="StatisticsChartPlot" TargetType="Grid">
                <Setter Property="Height" Value="240"/>
            </Style>
            <Style x:Key="StatisticsTotalAmount" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Sign}" Value="1">
                        <Setter Property="Foreground" Value="{DynamicResource Button.Foreground.Green}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sign}" Value="-1">
                        <Setter Property="Foreground" Value="{DynamicResource Foreground.Negative}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StatisticsTotalDetail" TargetType="TextBlock" BasedOn="{StaticResource GrayTextBlock}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <c:CastarComboBox x:Name="CurrencyPicker" MinWidth="88" Margin="24,4,24,12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="Collapsed" AutomationProperties.Name="Валюта статистики"
                          SelectionChanged="CurrencyPicker_SelectionChanged"/>
        <TextBlock x:Name="MissingAmounts" Grid.Row="1" Margin="{StaticResource BudgetStatusMargin}"
                   Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        <Grid x:Name="BudgetContent" Grid.Row="2" Margin="{StaticResource BudgetContentMargin}" SizeChanged="Charts_SizeChanged">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="3,0,3,6"
                           Foreground="{DynamicResource Foreground.Gray}" AutomationProperties.LiveSetting="Polite"
                           Visibility="Collapsed"/>
                <Grid x:Name="Dashboard" Visibility="Collapsed">
                  <ItemsControl x:Name="Totals" Tag="5" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatisticsChartSurface}">
                                <Grid ToolTip="{Binding Warning}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <ContentControl DockPanel.Dock="Right" Content="{DynamicResource Svg.Warning}" Margin="8,0,0,0"
                                                        Foreground="{DynamicResource Warning.Svg.Brush}"
                                                        VerticalAlignment="Center" Width="16" Height="16">
                                            <ContentControl.Style><Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style></ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource GrayTextBlock}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" LastChildFill="True">
                                        <c:CastarComboBox x:Name="ReserveHistoryPicker" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                          Margin="8,0,0,0" MinWidth="82" MinHeight="28" Padding="8,2,2,2" FontSize="12"
                                                          AutomationProperties.Name="Период расчёта финансовой подушки"
                                                          SelectedValuePath="Tag"
                                                          SelectedValue="{Binding ReserveHistorySelection, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:StatisticsContent}}}"
                                                          SelectionChanged="ReserveHistory_SelectionChanged">
                                            <c:CastarComboBox.Style>
                                                <Style TargetType="c:CastarComboBox" BasedOn="{StaticResource {x:Type c:CastarComboBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReserveSelector}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </c:CastarComboBox.Style>
                                            <ComboBoxItem Tag="3" Content="3 мес."/>
                                            <ComboBoxItem Tag="6" Content="6 мес."/>
                                            <ComboBoxItem Tag="12" Content="12 мес."/>
                                        </c:CastarComboBox>
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="32">
                                            <TextBlock Text="{Binding Amount}" Style="{StaticResource StatisticsTotalAmount}"/>
                                        </Viewbox>
                                    </DockPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Style="{StaticResource StatisticsTotalDetail}" Tag="{Binding AverageMonthlyExpenses}"
                                                   Text="{Binding AverageMonthlyExpenses, StringFormat='Расходы в месяц · {0}'}"/>
                                        <TextBlock Style="{StaticResource StatisticsTotalDetail}" Tag="{Binding EstimatedDepletion}"
                                                   Text="{Binding EstimatedDepletion, StringFormat='Хватит до {0}'}"/>
                                    </StackPanel>
                                    <ProgressBar Grid.RowSpan="3" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True">
                                        <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <Grid x:Name="Charts">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="RemainingColumn"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <c:StatisticsChartCard x:Name="RemainingPanel" Title="Динамика остатка средств"
                                           HeaderIcon="{StaticResource Lucide.chart-no-axes-combined}"/>
                    <c:StatisticsChartCard x:Name="BurnPanel" Grid.Column="1" Title="Скорость расходования бюджета"
                                           HeaderIcon="{StaticResource Lucide.gauge}">
                        <c:StatisticsChartCard.HeaderAction>
                            <StackPanel Orientation="Horizontal">
                                <c:CastarComboBox x:Name="BurnMonthPicker" MinWidth="110" Margin="0,0,8,0" DisplayMemberPath="Label"
                                    AutomationProperties.Name="Месяц расходования бюджета" SelectionChanged="BurnMonthPicker_SelectionChanged"/>
                                <c:CastarComboBox x:Name="BurnHistoryPicker" MinWidth="112" DisplayMemberPath="Value" SelectedValuePath="Key"
                                    AutomationProperties.Name="Период сравнения расходов" SelectionChanged="BurnHistoryPicker_SelectionChanged"/>
                            </StackPanel>
                        </c:StatisticsChartCard.HeaderAction>
                    </c:StatisticsChartCard>
                    <c:StatisticsChartCard x:Name="MonthlyPanel" Grid.Row="1" Title="Доходы и расходы по месяцам"
                                           HeaderIcon="{StaticResource Lucide.chart-column-increasing}"/>
                    <c:CategoryStatisticsChart x:Name="CategoriesPanel" Grid.Row="1" Grid.Column="1"/>
                    <c:StatisticsChartCard x:Name="HeatPanel" Grid.Row="2" Grid.ColumnSpan="2" Title="Тепловая карта расходов"
                                           HeaderIcon="{StaticResource Lucide.calendar-days}"/>
                </Grid>
            </StackPanel>
          </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
