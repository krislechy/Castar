<UserControl x:Class="Castar.Contents.StatisticsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Castar.Compontents"
             FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
             Loaded="Statistics_Loaded" Unloaded="Statistics_Unloaded"
             IsVisibleChanged="Statistics_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="StatisticsChartSurface" TargetType="Border">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Main.Background.lvl1}"/>
        </Style>
        <Style x:Key="StatisticsChartTitle" TargetType="TextBlock" BasedOn="{StaticResource BudgetHeaderTitle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatisticsChartPlot" TargetType="Grid">
            <Setter Property="Height" Value="240"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <c:CastarComboBox x:Name="CurrencyPicker" MinWidth="88" Margin="24,4,24,12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="Collapsed" AutomationProperties.Name="Валюта статистики"
                          SelectionChanged="CurrencyPicker_SelectionChanged"/>
        <TextBlock x:Name="MissingAmounts" Grid.Row="1" Margin="{StaticResource BudgetStatusMargin}"
                   Foreground="{DynamicResource Warning.Svg.Brush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        <Grid x:Name="BudgetContent" Grid.Row="2" Margin="{StaticResource BudgetContentMargin}" SizeChanged="Charts_SizeChanged">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="3,0,3,6"
                           Foreground="{DynamicResource Foreground.Gray}" AutomationProperties.LiveSetting="Polite"
                           Visibility="Collapsed"/>
                <Grid x:Name="Dashboard" Visibility="Collapsed">
                  <ItemsControl x:Name="Totals" Tag="4" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="16" CornerRadius="12"
                                    Background="{DynamicResource Main.Background.lvl1}">
                                <Grid ToolTip="{Binding Warning}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <ContentControl DockPanel.Dock="Right" Content="{DynamicResource Svg.Warning}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Width="16" Height="16">
                                            <ContentControl.Style><Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style></ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource GrayTextBlock}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="32">
                                        <TextBlock Text="{Binding Amount}" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Foreground.White}"/>
                                    </Viewbox>
                                    <ProgressBar Grid.RowSpan="2" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True">
                                        <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style></ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <Grid x:Name="Charts">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="RemainingColumn"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <c:StatisticsChartCard x:Name="TimelinePanel" Title="Динамика за период">
                        <c:StatisticsChartCard.HeaderAction>
                            <c:CastarComboBox x:Name="TimelineSeriesPicker" SelectedIndex="0" MinWidth="132"
                                AutomationProperties.Name="Ряды графика" SelectionChanged="TimelineSeriesPicker_SelectionChanged">
                                <ComboBoxItem Content="Доходы и расходы"/>
                                <ComboBoxItem x:Name="TimelineIncomesOnly" Content="Доходы"/>
                                <ComboBoxItem x:Name="TimelineExpensesOnly" Content="Расходы"/>
                            </c:CastarComboBox>
                        </c:StatisticsChartCard.HeaderAction>
                    </c:StatisticsChartCard>
                    <c:StatisticsChartCard x:Name="RemainingPanel" Grid.Column="1" Title="Динамика остатка средств"/>
                    <c:StatisticsChartCard x:Name="MonthlyPanel" Grid.Row="1" Title="Доходы и расходы по месяцам"/>
                    <c:StatisticsChartCard x:Name="BurnPanel" Grid.Row="1" Grid.Column="1" Title="Скорость расходования бюджета">
                        <c:StatisticsChartCard.HeaderAction>
                            <c:CastarComboBox x:Name="BurnMonthPicker" MinWidth="110" DisplayMemberPath="Label"
                                AutomationProperties.Name="Месяц расходования бюджета" SelectionChanged="BurnMonthPicker_SelectionChanged"/>
                        </c:StatisticsChartCard.HeaderAction>
                    </c:StatisticsChartCard>
                    <c:StatisticsChartCard x:Name="HeatPanel" Grid.Row="2" Grid.ColumnSpan="2" Title="Тепловая карта расходов"/>
                </Grid>
            </StackPanel>
          </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
