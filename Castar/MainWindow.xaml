<Window x:Class="Castar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Castar"
        xmlns:c="clr-namespace:Castar.Compontents"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:menuCommands="clr-namespace:Castar.Commands"
        mc:Ignorable="d"
        Icon="pack://application:,,,/Castar;component/logo.ico"
        FontFamily="{StaticResource Castar.FontFamily}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Padding="0"
        Margin="0"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closing="thisClosing" PreviewKeyDown="Navigation_PreviewKeyDown"
        Background="{DynamicResource Main.Background.lvl1}"
        Style="{DynamicResource WithoutChrome}"
        Title="Castar" MinHeight="600" MinWidth="1000">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Castar;component/Styles/Navigation.xaml"/>
            <ResourceDictionary Source="/Castar;component/Styles/LedgerCards.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="SystemCommandBinding_CanExecute_Default" Executed="SystemCommandBinding_Executed_Minimize"/>
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="SystemCommandBinding_CanExecute_Default" Executed="SystemCommandBinding_Executed_Maximize"/>

        <CommandBinding Command="{x:Static menuCommands:MenuSelector.MenuSelect}" Executed="MenuSelectorCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Border BorderThickness="0" Margin="0" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!--#region Top-->
            <Grid Grid.Row="0" Background="{DynamicResource Main.Top.Panel}" MouseMove="Grid_MouseMove" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Height="20" Width="20" Margin="5,0,0,0"
                           Source="{Binding Icon,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Margin="5,0,0,0" Style="{StaticResource GrayTextBlock}"
                               Text="{Binding Title,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window}}"/>
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource System.Button}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            Grid.Column="0" Content="{DynamicResource Svg.Minimize}" AutomationProperties.Name="Свернуть"/>
                    <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}" Grid.Column="1">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource System.Button}">
                                <Setter Property="Content" Value="{DynamicResource Svg.Maximize.1}"/>
                                <Setter Property="AutomationProperties.Name" Value="Развернуть"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Normal">
                                        <Setter Property="Content" Value="{DynamicResource Svg.Maximize.1}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="{DynamicResource Svg.Maximize.2}"/>
                                        <Setter Property="AutomationProperties.Name" Value="Восстановить размер"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{DynamicResource System.Button}" Click="SystemButtonClose" Grid.Column="2" Foreground="OrangeRed"
                            Content="{DynamicResource Svg.Close}" AutomationProperties.Name="Закрыть"/>
                </Grid>
            </Grid>
            <!--#endregion-->
            <Grid Grid.Row="1">
                <Grid x:Name="MainWorkspace" PreviewGotKeyboardFocus="MainWorkspace_PreviewGotKeyboardFocus">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!--#region Content-->
                    <Grid Grid.Column="1" Background="{StaticResource Main.Background.lvl2}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="SharedPeriodSurface" Grid.Row="0" Margin="24,16,24,0" Padding="16,12"
                                Background="{StaticResource LedgerSurface}" BorderBrush="{StaticResource LedgerBorder}"
                                BorderThickness="1" CornerRadius="12">
                            <c:SelectorRangeDates x:Name="SharedPeriodSelector" UseLedgerStyle="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="MainContent" Grid.Row="1" Margin="0"/>
                        <Grid x:Name="SharedPeriodShadow" Grid.Row="1" Height="36" Margin="8,0" VerticalAlignment="Top"
                                Visibility="{Binding Visibility, ElementName=SharedPeriodSurface}"
                                IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38000000" Offset="0"/>
                                    <GradientStop Color="#30000000" Offset="0.45"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Grid.Column="1" Background="Black"/>
                            <Border Grid.Column="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <!--#endregion-->
                    <Border x:Name="NavigationDismissLayer" Grid.Column="1" Background="Transparent" Visibility="Collapsed"
                            Panel.ZIndex="10" MouseLeftButtonDown="NavigationDismiss_Click"/>
                    <Border x:Name="NavigationDrawer" Grid.ColumnSpan="2" Width="240" HorizontalAlignment="Left"
                            Panel.ZIndex="11" Background="{StaticResource NavigationSurface}" BorderBrush="{StaticResource NavigationBorder}"
                            BorderThickness="0" SizeChanged="NavigationDrawer_SizeChanged" MouseEnter="NavigationDrawer_MouseEnter" MouseLeave="NavigationDrawer_MouseLeave" SnapsToDevicePixels="True">
                        <Border.Clip><RectangleGeometry x:Name="NavigationClip" Rect="0,0,64,10000"/></Border.Clip>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <StackPanel x:Name="MenuToggleButtons" Grid.Row="1" Margin="0,12,0,0">
                                <ToggleButton Style="{StaticResource NavigationItem}" Content="{StaticResource Svg.Menu.Incomes}" Tag="Доходы"
                                              ToolTip="Доходы" AutomationProperties.Name="Доходы"
                                              Command="{x:Static menuCommands:MenuSelector.MenuSelect}" CommandParameter="Incomes"/>
                                <ToggleButton Style="{StaticResource NavigationItem}" Content="{StaticResource Svg.Menu.Purchases}" Tag="Расходы"
                                              ToolTip="Расходы" AutomationProperties.Name="Расходы"
                                              Command="{x:Static menuCommands:MenuSelector.MenuSelect}" CommandParameter="Purchases"/>
                                <ToggleButton x:Name="StatisticsMenuButton" Style="{StaticResource NavigationItem}" Content="{StaticResource Svg.Menu.Statistics}" Tag="Статистика"
                                              ToolTip="Статистика" AutomationProperties.Name="Статистика"
                                              Command="{x:Static menuCommands:MenuSelector.MenuSelect}" CommandParameter="Statistics"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <ToggleButton x:Name="SettingsMenuButton" Style="{StaticResource NavigationItem}" Content="{StaticResource Svg.Menu.Settings}" Tag="Настройки"
                                              ToolTip="Настройки" AutomationProperties.Name="Настройки"
                                              Command="{x:Static menuCommands:MenuSelector.MenuSelect}" CommandParameter="Settings"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <!--#region Popup-->
                <Grid x:Name="SettingsOverlay" Visibility="Collapsed"
                      PreviewKeyDown="SettingsOverlay_PreviewKeyDown">
                    <Border x:Name="SettingsBackdrop" Background="Transparent" MouseLeftButtonDown="SettingsBackdrop_Click"/>
                    <Border x:Name="SettingsShell" Margin="16,12" MaxWidth="510" CornerRadius="12" VerticalAlignment="Top"
                            Background="{DynamicResource Main.Background.lvl1}"
                            BorderBrush="{DynamicResource Main.Top.Panel}" BorderThickness="1"
                            ClipToBounds="True">
                        <ContentPresenter x:Name="SettingsPresenter" SizeChanged="SettingsPresenter_SizeChanged"/>
                    </Border>
                </Grid>
                <c:PopupDialog x:Name="MainDialog"/>
                <!--#endregion-->
            </Grid>
        </Grid>
    </Border>
</Window>
