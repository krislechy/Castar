<Window x:Class="Castar.Notifications.NotificationToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Castar.Compontents"
        Title="Уведомления Castar" FontFamily="Segoe UI" FontSize="14"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NotificationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="NotificationIcon" TargetType="ContentControl">
            <Setter Property="Content" Value="{DynamicResource Svg.Menu.Purchases}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Highlight}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="income">
                    <Setter Property="Content" Value="{DynamicResource Svg.Menu.Incomes}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="DismissAllPanel" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                CornerRadius="8" Background="{DynamicResource Main.Background.lvl2}" Visibility="Collapsed">
            <Button x:Name="DismissAll" Style="{StaticResource NotificationButton}" FontSize="13"
                    Padding="12,0" Content="Закрыть все" Height="28" Click="DismissAll_Click"/>
        </Border>
        <ItemsControl x:Name="NotificationItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Main.Background.lvl1}" BorderBrush="{DynamicResource Main.Top.Panel}"
                            BorderThickness="1" CornerRadius="8" Height="56" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Width="36" Padding="7"
                                    Style="{StaticResource NotificationButton}"
                                    Content="{DynamicResource Svg.Close}" Click="Dismiss_Click"
                                    AutomationProperties.Name="Закрыть уведомление"/>
                            <Button Style="{StaticResource NotificationButton}" Click="Open_Click" Padding="8,4"
                                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AccessibleText}">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource NotificationIcon}"/>
                                    <c:UserAvatar DockPanel.Dock="Left" Width="28" Height="28"
                                                  UserName="{Binding Preview.Author, FallbackValue=''}"
                                                  Photo="{Binding Avatar, Converter={StaticResource UserAvatarImageConverter}}">
                                        <c:UserAvatar.Style>
                                            <Style TargetType="c:UserAvatar">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:UserAvatar.Style>
                                    </c:UserAvatar>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="12" Margin="0"
                                                   Style="{StaticResource ViewStatus}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GroupLabel}" FontSize="11" Margin="0"
                                                   Style="{StaticResource ViewStatus}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
