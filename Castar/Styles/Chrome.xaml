<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WithoutChrome" TargetType="{x:Type Window}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- The 27 DIP caption starts below the 3 DIP top resize edge. -->
                <WindowChrome CaptionHeight="27"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            UseAeroCaptionButtons="False"
            ResizeBorderThickness="3"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Window.BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
                <Setter Property="BorderBrush" Value="{DynamicResource Main.Background.lvl2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
