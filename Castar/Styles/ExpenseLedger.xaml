<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LedgerCards.xaml"/></ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="LedgerExpense" Color="{Binding Color, Source={StaticResource PurchaseForm.Foreground}, Mode=OneTime}"/>
 <Style x:Key="ExpenseCardSurface" TargetType="Border" BasedOn="{StaticResource Castar.Panel}">
  <Setter Property="Background" Value="{StaticResource LedgerSurface}"/><Setter Property="BorderBrush" Value="{StaticResource LedgerBorder}"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
 </Style>
 <Style x:Key="ExpensePurchaseRow" TargetType="ListViewItem" BasedOn="{StaticResource LedgerCardRow}">
  <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="8,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="MinHeight" Value="60"/>
  <Setter Property="Border.CornerRadius" Value="{DynamicResource Castar.Corner.Control}"/>
 </Style>
 <Style x:Key="ExpensePurchaseDayRow" TargetType="ListViewItem" BasedOn="{StaticResource ExpensePurchaseRow}">
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListViewItem">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="PurchaseDaySeparator" Margin="8,4,8,3" Visibility="Collapsed" IsHitTestVisible="False">
       <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid x:Name="PurchaseDayBadge" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse Fill="{DynamicResource Castar.Selection}"/>
        <TextBlock Text="{Binding PurchaseDayLabel}" Foreground="{DynamicResource Castar.Accent}"
                   FontSize="{StaticResource Castar.Font.Caption}" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
       <DockPanel Grid.Column="1" Margin="8,0,0,0">
        <ContentControl x:Name="PurchaseDayTotalWarning" DockPanel.Dock="Right"
                        Style="{DynamicResource ExpenseAmountWarning}" ToolTip="{Binding DayTotalWarning}"/>
        <TextBlock x:Name="PurchaseDayTotal" DockPanel.Dock="Right" Text="{Binding DayTotal}"
                   Margin="8,0,0,0" Foreground="{StaticResource LedgerMuted}"
                   FontSize="{StaticResource Castar.Font.Caption}" FontWeight="SemiBold"
                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
        <Border x:Name="PurchaseDaySeparatorLine" Height="1" VerticalAlignment="Center"
                Background="{DynamicResource Castar.Accent}" Opacity="0.15" SnapsToDevicePixels="True"/>
       </DockPanel>
      </Grid>
      <Border x:Name="PurchaseRowSurface" Grid.Row="1" MinHeight="{TemplateBinding MinHeight}"
              Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding Border.CornerRadius}">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding StartsPurchaseDay}" Value="True">
       <Setter TargetName="PurchaseDaySeparator" Property="Visibility" Value="Visible"/>
      </DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ExpenseItemRow" TargetType="ListViewItem" BasedOn="{StaticResource ExpensePurchaseRow}">
  <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="8,6,0,7"/><Setter Property="MinHeight" Value="40"/>
  <Setter Property="BorderThickness" Value="0"/>
 </Style>
 <Style x:Key="ExpenseRowActions" TargetType="Button" BasedOn="{StaticResource LedgerIconButton}">
  <Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Width" Value="28"/><Setter Property="Padding" Value="5"/>
  <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="ExpenseSectionTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
 </Style>
</ResourceDictionary>
