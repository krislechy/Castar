<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FormFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>

    <Style x:Key="FormAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="BudgetPeriodBar" TargetType="WrapPanel">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormSliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Foreground}"
                                              Style="{StaticResource FormSliderTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="{DynamicResource Main.Top.Panel}"
                                              Style="{StaticResource FormSliderTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="15" Height="15" Background="{TemplateBinding Foreground}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Background="{TemplateBinding Background}" CornerRadius="8"
                                                    BorderBrush="{DynamicResource Main.Background.lvl1}" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Foreground.White}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <Border x:Name="Focus" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BudgetHeaderSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Main.Background.lvl2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Main.Top.Panel}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="BudgetHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,14,0"/>
    </Style>

    <Style x:Key="BudgetOptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BudgetEditedMarker" TargetType="TextBlock">
        <Setter Property="Text" Value="&#xE70F;"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="ToolTip" Value="Изменено"/>
        <Setter Property="AutomationProperties.Name" Value="Изменено"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Thickness x:Key="BudgetStatusMargin">12,0,12,8</Thickness>
    <Thickness x:Key="BudgetContentMargin">8,0,8,8</Thickness>

    <Style x:Key="ViewStatus" TargetType="TextBlock" BasedOn="{StaticResource GrayTextBlock}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
