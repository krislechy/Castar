<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FormFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FormAction" TargetType="Button" BasedOn="{StaticResource Castar.SecondaryButton}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="FormPrimaryAction" TargetType="Button" BasedOn="{StaticResource Castar.PrimaryButton}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="BudgetAddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Margin="2" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource Castar.Focus}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BudgetPeriodBar" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormSliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormSlider" TargetType="Slider">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="5" Margin="7.5,0" VerticalAlignment="Center" CornerRadius="2.5"
                                Background="{TemplateBinding Background}" IsHitTestVisible="False"/>
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseTrack" Command="{x:Static Slider.DecreaseLarge}" Background="Transparent"
                                              Style="{StaticResource FormSliderTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseTrack" Command="{x:Static Slider.IncreaseLarge}" Background="Transparent"
                                              Style="{StaticResource FormSliderTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Width="15" Height="15" Background="{TemplateBinding Foreground}"
                                       BorderBrush="{DynamicResource Main.Background.lvl1}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Background="{TemplateBinding Background}" CornerRadius="8"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Foreground.White}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <Border x:Name="Focus" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Background" Value="{x:Null}">
                            <Setter TargetName="DecreaseTrack" Property="Background"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="IncreaseTrack" Property="Background" Value="{DynamicResource Main.Top.Panel}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SliderThumb" Property="BorderBrush" Value="{DynamicResource Foreground.White}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                <Condition Property="Background" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SliderThumb" Property="BorderBrush" Value="{DynamicResource Main.Background.lvl1}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BudgetHeaderSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Main.Background.lvl2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Main.Top.Panel}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="24,20,24,12"/>
    </Style>

    <Style x:Key="BudgetHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>

    <Style x:Key="BudgetOptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BudgetEditedMarker" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Lucide.pencil}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource Highlight}"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="ToolTip" Value="Изменено"/>
        <Setter Property="AutomationProperties.Name" Value="Изменено"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Thickness x:Key="BudgetStatusMargin">24,0,24,8</Thickness>
    <Thickness x:Key="BudgetContentMargin">20,0,20,20</Thickness>

    <Style x:Key="ViewStatus" TargetType="TextBlock" BasedOn="{StaticResource GrayTextBlock}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
