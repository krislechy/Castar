<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Castar.Compontents">
 <SolidColorBrush x:Key="LedgerCanvas" Color="{Binding GradientStops[1].Color, Source={StaticResource PurchaseForm.DialogBackground}, Mode=OneTime}"/>
 <SolidColorBrush x:Key="LedgerSurface" Color="{Binding GradientStops[0].Color, Source={StaticResource PurchaseForm.DialogBackground}, Mode=OneTime}"/>
 <SolidColorBrush x:Key="LedgerBorder" Color="{Binding Color, Source={StaticResource PurchaseForm.PanelBorder}, Mode=OneTime}"/>
 <SolidColorBrush x:Key="LedgerMuted" Color="{Binding Color, Source={StaticResource PurchaseForm.Muted}, Mode=OneTime}"/>
 <SolidColorBrush x:Key="LedgerIncome" Color="#90ee90"/>
 <Viewbox x:Key="Ledger.EditIcon" x:Shared="False" Width="16" Height="16">
  <Path Data="{StaticResource Lucide.pencil}" Fill="Transparent" Stroke="{DynamicResource Foreground.White}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
 </Viewbox>
 <Viewbox x:Key="Ledger.DeleteIcon" x:Shared="False" Width="16" Height="16">
  <Path Data="{StaticResource Lucide.trash-2}" Fill="Transparent" Stroke="{DynamicResource Foreground.White}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
 </Viewbox>
 <Viewbox x:Key="Ledger.SourceIcon" x:Shared="False" Width="16" Height="16">
  <Path Data="{StaticResource Lucide.file-text}" Fill="Transparent" Stroke="{DynamicResource Foreground.White}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
 </Viewbox>
 <ControlTemplate x:Key="LedgerButtonTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}" SnapsToDevicePixels="True">
                <Grid>
                    <Border x:Name="Hover" Background="{DynamicResource Main.MouseOver}" CornerRadius="{TemplateBinding Border.CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="Pressed" Background="{DynamicResource Main.MousePressed}" CornerRadius="{TemplateBinding Border.CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        TextElement.Foreground="{TemplateBinding Foreground}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    <ContentControl x:Name="BusyIndicator" Style="{StaticResource Castar.ButtonBusyIndicator}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pressed" Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                <Trigger Property="c:ButtonLoading.IsBusy" Value="True">
                    <Setter TargetName="ButtonContent" Property="Opacity" Value="0"/>
                    <Setter TargetName="Surface" Property="Opacity" Value="1"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="c:ButtonLoading.IsBusy" Value="True"/>
                        <Condition Property="c:ButtonLoading.AllowInteractionWhileBusy" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="ButtonContent" Property="Opacity" Value="1"/>
                    <Setter TargetName="BusyIndicator" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BusyIndicator" Property="Margin" Value="8,0,8,0"/>
                </MultiTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard FillBehavior="Stop">
                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                    </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
 <Style x:Key="LedgerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0"/>
  <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/><Setter Property="Background" Value="{DynamicResource PurchaseForm.Action}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Castar.FieldBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Typography.Capitals" Value="Normal"/>
  <Setter Property="Template" Value="{StaticResource LedgerButtonTemplate}"/>
 </Style>
 <Style x:Key="LedgerPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource LedgerActionButton}">
  <Setter Property="Background" Value="{DynamicResource PurchaseForm.PrimaryAction}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource PurchaseForm.PrimaryBorder}"/>
 </Style>
 <Style x:Key="LedgerCategorySettingsButton" TargetType="Button" BasedOn="{StaticResource LedgerActionButton}">
  <Setter Property="Content" Value="Настройки категорий"/>
  <Setter Property="AutomationProperties.Name" Value="Настройки категорий"/>
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="ContentTemplate">
   <Setter.Value>
    <DataTemplate>
     <StackPanel Orientation="Horizontal">
      <ContentPresenter Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                        Content="{DynamicResource Svg.Menu.Categories}" TextElement.Foreground="{DynamicResource Castar.Accent}"/>
      <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
     </StackPanel>
    </DataTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="LedgerPeriodClassificationButton" TargetType="c:PeriodClassificationButton" BasedOn="{StaticResource LedgerActionButton}">
  <Setter Property="Content" Value="Категоризировать за период"/>
  <Setter Property="AutomationProperties.Name" Value="Категоризировать за период"/>
  <Setter Property="AutomationProperties.HelpText" Value="{Binding Count, RelativeSource={RelativeSource Self}, StringFormat='Без категории: {0}'}"/>
  <Setter Property="ToolTip" Value="Категоризировать за период"/>
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="MinWidth" Value="44"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="c:ButtonLoading.IsBusy" Value="{Binding IsBusy, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="ContentTemplate">
   <Setter.Value>
    <DataTemplate>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Data="{StaticResource Lucide.wand-sparkles}"
            Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
            Stroke="{DynamicResource Castar.Accent}" StrokeThickness="1.55"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      <StackPanel x:Name="PendingCount" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
       <Path Data="{StaticResource Lucide.triangle-alert}"
             Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
             Stroke="{DynamicResource Warning.Svg.Brush}" StrokeThickness="1.4"
             StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       <TextBlock Text="{Binding Count, RelativeSource={RelativeSource AncestorType=c:PeriodClassificationButton}}"
                  Foreground="{DynamicResource Warning.Svg.Brush}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </StackPanel>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Count, RelativeSource={RelativeSource AncestorType=c:PeriodClassificationButton}}" Value="0">
       <Setter TargetName="PendingCount" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsAvailable" Value="False"><Setter Property="IsEnabled" Value="False"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="LedgerSearchSurface" TargetType="Border" BasedOn="{StaticResource Castar.Panel}">
  <Setter Property="Background" Value="{DynamicResource Castar.Field}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Castar.FieldBorder}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource Castar.Corner.Control}"/>
  <Style.Triggers>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Castar.Focus}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="LedgerIconButton" TargetType="Button" BasedOn="{StaticResource LedgerActionButton}">
  <Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
  <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Main.MouseOver}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="LedgerSearchClearButton" TargetType="Button" BasedOn="{StaticResource LedgerIconButton}">
  <Setter Property="Width" Value="24"/>
  <Setter Property="Height" Value="24"/>
  <Setter Property="MinHeight" Value="24"/>
  <Setter Property="Padding" Value="4"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{StaticResource LedgerMuted}"/>
  <Setter Property="Content" Value="Очистить поиск"/>
  <Setter Property="AutomationProperties.Name" Value="Очистить поиск"/>
  <Setter Property="ContentTemplate">
   <Setter.Value>
    <DataTemplate>
     <Path Data="{StaticResource Lucide.x}" Width="12" Height="12" Stretch="Uniform"
           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
           StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </DataTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
   <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="LedgerGroupExpander" TargetType="Expander">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,16"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <Border x:Name="Surface" Background="{StaticResource LedgerSurface}" BorderBrush="{StaticResource LedgerBorder}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid c:RoundedClip.Radius="11">
     <StackPanel>
      <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Padding="16,12" HorizontalContentAlignment="Stretch" FocusVisualStyle="{StaticResource Castar.FocusVisual}" AutomationProperties.Name="{Binding Header.Name, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Padding="{TemplateBinding Padding}" Background="Transparent">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Path x:Name="Chevron" Data="{StaticResource Lucide.chevron-right}" Stroke="{DynamicResource Foreground.White}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
         <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Grid>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
      <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
     </ToggleButton>
     <Border x:Name="Body" Visibility="Collapsed" Background="Transparent"><ContentPresenter/></Border>
     </StackPanel>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LedgerCardRow" TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
  <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="10,13"/><Setter Property="BorderThickness" Value="0,1,0,0"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource LedgerBorder}"/><Setter Property="Border.CornerRadius" Value="0"/><Setter Property="MinHeight" Value="70"/><Setter Property="ContextMenu" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
   <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Main.MouseOver}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Castar.Selection}"/></Trigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="LedgerIncomeRow" TargetType="ListViewItem" BasedOn="{StaticResource LedgerCardRow}">
  <Setter Property="Padding" Value="26,13"/>
 </Style>

 <Style x:Key="LedgerPeriodComparison" TargetType="ContentControl">
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="HorizontalAlignment" Value="Right"/>
  <Setter Property="MaxWidth" Value="300"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContentControl">
     <StackPanel>
      <Border x:Name="Badge" Background="{DynamicResource Main.Background.lvl3}" BorderBrush="{StaticResource LedgerBorder}"
              CornerRadius="8" BorderThickness="1" Padding="12,5" HorizontalAlignment="Right">
       <TextBlock x:Name="Amount" Text="{Binding ComparisonText}" Foreground="{StaticResource LedgerMuted}" FontSize="16"
                  FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right"/>
      </Border>
      <TextBlock Text="{Binding ComparisonHint}" Foreground="{StaticResource LedgerMuted}" FontSize="12"
                 TextAlignment="Right" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding IsComparisonFavorable}" Value="True">
       <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource LedgerIncome}"/>
       <Setter TargetName="Amount" Property="Foreground" Value="{StaticResource LedgerIncome}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsComparisonUnfavorable}" Value="True">
       <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Warning.Svg.Brush}"/>
       <Setter TargetName="Amount" Property="Foreground" Value="{DynamicResource Warning.Svg.Brush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsComparisonLoading}" Value="True">
       <Setter TargetName="Badge" Property="Opacity" Value="0.6"/>
      </DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <Style x:Key="LedgerSummaryIcon" TargetType="ContentControl">
  <Setter Property="Width" Value="64"/><Setter Property="Height" Value="64"/>
  <Setter Property="Margin" Value="0,0,20,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid>
    <Ellipse Fill="{DynamicResource PurchaseForm.Badge}"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="LedgerSelectionTotal" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource LedgerSurface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LedgerBorder}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
  <Setter Property="Padding" Value="12,8"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Visibility" Value="Collapsed"/>
 </Style>
 <Style x:Key="LedgerSelectionTotalText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
 </Style>

 <Style x:Key="LedgerContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
  <Setter Property="HasDropShadow" Value="False"/><Setter Property="OverridesDefaultStyle" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Background="{StaticResource LedgerSurface}" BorderBrush="{StaticResource LedgerBorder}" BorderThickness="1" CornerRadius="12" Padding="4" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="LedgerScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
   <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0"
      Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"
      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" Orientation="Vertical"
      Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Orientation="Horizontal"
      Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
      Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LedgerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
  <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinWidth" Value="150"/>
  <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Typography.Capitals" Value="Normal"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
     <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/><Setter Property="Foreground" Value="{DynamicResource Highlight}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="LedgerCalendar" TargetType="Calendar" BasedOn="{StaticResource CastarCalendar}">
  <Setter Property="Background" Value="{StaticResource LedgerSurface}"/><Setter Property="BorderBrush" Value="{StaticResource LedgerBorder}"/>
 </Style>
 <ControlTemplate x:Key="LedgerDatePickerTemplate" TargetType="c:CastarDatePicker">
  <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" UseLayoutRounding="True">
   <Grid x:Name="PART_Root"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <TextBox x:Name="DateInput" MinHeight="40" Background="Transparent" AllowDrop="False" BorderThickness="0" Padding="10,8" Foreground="{TemplateBinding Foreground}" FontSize="15" AutomationProperties.Name="Дата"/>
    <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource LedgerIconButton}" Focusable="False" Margin="0" Padding="6" MinHeight="0" AutomationProperties.Name="Открыть календарь" Content="{DynamicResource Svg.DatePicker}"/>
    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Field}" StaysOpen="False"/>
   </Grid>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Highlight}"/></Trigger>
   <Trigger Property="HasInvalidInput" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Warning.Svg.Brush}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.56"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
</ResourceDictionary>
