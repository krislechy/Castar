<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Castar;component/Styles/PurchaseFormPalette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="PurchaseForm.OwnerSurface" Color="#151923"/>
    <SolidColorBrush x:Key="PurchaseForm.RemoveSurface" Color="#424557"/>

    <BooleanToVisibilityConverter x:Key="PurchaseFormVisibility"/>
    <sys:Boolean x:Key="PurchaseForm.StyledInput">True</sys:Boolean>
    <Style x:Key="PurchaseFormFieldIcon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="11,0,0,0"/>
        <Setter Property="Stroke" Value="{DynamicResource Foreground.Gray}"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="PurchaseFormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Padding" Value="34,7,10,7"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PurchaseFormPlaceholder" TargetType="TextBlock">
        <Setter Property="Margin" Value="35,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource Castar.FontFamily}"/>
        <Setter Property="FontSize" Value="{Binding Tag.FontSize, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Muted}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag.Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value=""/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PurchaseFormStepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="29"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{StaticResource PurchaseForm.Action}"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Muted}"/>
    </Style>

    <Style x:Key="PurchaseFormOwnerListItem" TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
        <Setter Property="Padding" Value="8,9"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource PurchaseForm.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource PurchaseForm.Selection}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PurchaseForm.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PurchaseForm.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PurchaseFormOwnerList" TargetType="ListView" BasedOn="{StaticResource BudgetList}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PurchaseFormOwnerListItem}"/>
    </Style>
</ResourceDictionary>
