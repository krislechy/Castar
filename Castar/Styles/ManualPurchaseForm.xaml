<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Castar;component/Styles/PurchaseFormPalette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="PurchaseForm.OwnerSurface" Color="#151923"/>
    <SolidColorBrush x:Key="PurchaseForm.RemoveSurface" Color="#424557"/>

    <BooleanToVisibilityConverter x:Key="PurchaseFormVisibility"/>
    <sys:Boolean x:Key="PurchaseForm.StyledInput">True</sys:Boolean>
    <Geometry x:Key="PurchaseForm.NameIcon">M2,9 L9,2 H16 V9 L9,16 Q8,17 7,16 L2,11 Q1,10 2,9 Z M12,5 H13</Geometry>
    <Geometry x:Key="PurchaseForm.RetailIcon">M3,7 L5,2 H13 L15,7 V9 Q13,11 11,9 Q9,11 7,9 Q5,11 3,9 Z M4,10 V16 H14 V10 M8,16 V12 H11 V16</Geometry>
    <Geometry x:Key="PurchaseForm.AddressIcon">M9,16 Q3,11 3,8 A6,6 0 1 1 15,8 Q15,11 9,16 Z M9,6 A2,2 0 1 1 9,10 A2,2 0 1 1 9,6 Z</Geometry>
    <Geometry x:Key="PurchaseForm.TimeIcon">M16,9 A7,7 0 1 1 2,9 A7,7 0 1 1 16,9 Z M9,5 V9 L12,11</Geometry>
    <Geometry x:Key="PurchaseForm.CurrencyIcon">M3,6 A6,2.5 0 1 1 15,6 A6,2.5 0 1 1 3,6 Z M3,6 V13 Q3,16 9,16 Q15,16 15,13 V6 M3,9.5 Q3,12 9,12 Q15,12 15,9.5</Geometry>
    <Geometry x:Key="PurchaseForm.ItemIcon">M9,2 L16,6 V13 L9,17 2,13 V6 Z M2,6 L9,10 16,6 M9,10 V17</Geometry>
    <Geometry x:Key="PurchaseForm.EditIcon">M3,13 L12.5,3.5 A2,2 0 0 1 15.3,6.3 L5.8,15.8 L2,16.8 Z M11,5 L13.8,7.8</Geometry>
    <Geometry x:Key="PurchaseForm.RemoveIcon">M4,4 L12,12 M12,4 L4,12</Geometry>
    <Style x:Key="PurchaseFormFieldIcon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="11,0,0,0"/>
        <Setter Property="Stroke" Value="{DynamicResource Foreground.Gray}"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="PurchaseFormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Padding" Value="34,7,10,7"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PurchaseFormPlaceholder" TargetType="TextBlock">
        <Setter Property="Margin" Value="35,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource Castar.FontFamily}"/>
        <Setter Property="FontSize" Value="{Binding Tag.FontSize, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Muted}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag.Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value=""/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PurchaseFormStepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="29"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{StaticResource PurchaseForm.Action}"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Muted}"/>
    </Style>

    <Style x:Key="PurchaseFormOwnerListItem" TargetType="ListViewItem" BasedOn="{StaticResource BudgetListItem}">
        <Setter Property="Padding" Value="8,9"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Border.CornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource PurchaseForm.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource PurchaseForm.Selection}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PurchaseForm.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PurchaseForm.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PurchaseFormOwnerList" TargetType="ListView" BasedOn="{StaticResource BudgetList}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PurchaseForm.Foreground}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PurchaseFormOwnerListItem}"/>
    </Style>
</ResourceDictionary>
