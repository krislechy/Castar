<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Castar.Compontents">
    <SolidColorBrush x:Key="NavigationSurface" Color="#18191d"/>
    <SolidColorBrush x:Key="NavigationBorder" Color="#313b43"/>
    <Style x:Key="NavigationItem" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="10,0,10,8"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Typography.Capitals" Value="Normal"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Content" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Highlight}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Highlight}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Width" Value="44"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NavigationBrandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="56"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent"><Grid><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Stretch" VerticalAlignment="Center"/><ContentControl x:Name="BusyIndicator" Style="{StaticResource Castar.ButtonBusyIndicator}"/></Grid></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/></Trigger>
                <Trigger Property="c:ButtonLoading.IsBusy" Value="True"><Setter TargetName="ButtonContent" Property="Opacity" Value="0"/></Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="c:ButtonLoading.IsBusy" Value="True"/>
                        <Condition Property="c:ButtonLoading.AllowInteractionWhileBusy" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="ButtonContent" Property="Opacity" Value="1"/>
                    <Setter TargetName="BusyIndicator" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BusyIndicator" Property="Margin" Value="8,0,8,0"/>
                </MultiTrigger>

            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
