<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Castar.Compontents">
    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Margin="1" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource Castar.Focus}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSubpageButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Width="6" Height="10" Margin="12,0,0,0"
                              VerticalAlignment="Center" Stretch="Uniform" Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <ContentPresenter DockPanel.Dock="Left" Width="18" Margin="0,0,10,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Content="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Gray}"/>
    </Style>

    <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Width="6" Height="10" Margin="12,0,0,0"
                              VerticalAlignment="Center" Stretch="Uniform" Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{DynamicResource Foreground.Gray}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <ContentPresenter Width="24" DockPanel.Dock="Left" Margin="0,0,16,0"
                                          TextElement.Foreground="{DynamicResource Foreground.Gray}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Content="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsGroup" TargetType="Border" BasedOn="{StaticResource Castar.Panel}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Foreground.White}"/>
    </Style>

    <Style x:Key="SettingsNavigationGroup" TargetType="Border" BasedOn="{StaticResource SettingsGroup}">
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style x:Key="SettingsUpdateBanner" TargetType="Border" BasedOn="{StaticResource SettingsGroup}">
        <Setter Property="Background" Value="{DynamicResource Castar.Selection}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Castar.FieldBorder}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ClientUpdateAvailable}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsDangerAction" TargetType="Button" BasedOn="{StaticResource FormAction}">
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Negative}"/>
    </Style>

    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Main.Background.lvl1}"/>
    </Style>

    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SettingsNotificationBell" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.35"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource Highlight}"/>
        <Setter Property="Data" Value="M3,12 H13 L11.5,10 V6 A3.5,3.5 0 0 0 4.5,6 V10 Z M6.5,14 A1.5,1.5 0 0 0 9.5,14"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TelegramNotificationsEnabled}" Value="False">
                <Setter Property="Stroke" Value="{DynamicResource Foreground.Gray}"/>
                <Setter Property="Data" Value="M3,12 H10 M4.5,9.5 V6.5 M6,3.2 A3.5,3.5 0 0 1 11.5,6 V8.5 M6.5,14 A1.5,1.5 0 0 0 9.5,14 M2,2 L14,14"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsSwitchRow" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Castar.FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="4,8">
                        <VisualStateManager.CustomVisualStateManager>
                            <c:SettingsSwitchMotion/>
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.14">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedTrack" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="18" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckedThumb" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <DockPanel LastChildFill="True">
                            <Border x:Name="Track" DockPanel.Dock="Right" Background="{DynamicResource Castar.ScrollThumb}"
                                    Margin="12,0,0,0" Width="36" Height="18" CornerRadius="9" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="CheckedTrack" Background="{DynamicResource PurchaseForm.PrimaryAction}"
                                            CornerRadius="9" Opacity="0"/>
                                    <Grid x:Name="Thumb" Width="12" Height="12" Margin="3,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform/>
                                        </Grid.RenderTransform>
                                        <Ellipse Fill="{DynamicResource Main.Background.lvl2}"/>
                                        <Ellipse x:Name="CheckedThumb" Fill="{DynamicResource Foreground.White}" Opacity="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Main.MouseOver}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="CheckedTrack" Property="Background" Value="{DynamicResource Foreground.Gray}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
