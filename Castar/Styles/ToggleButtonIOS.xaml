<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ToggleButtonIOS" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Tag" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border x:Name="Border" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"
                    Background="{DynamicResource Main.Background.lvl3}" BorderBrush="{DynamicResource Foreground.Gray}" BorderThickness="1">
                    <Ellipse x:Name="Ellipse" Width="14" Height="14" Fill="{DynamicResource Foreground.White}" HorizontalAlignment="Left" Margin="2,0,0,0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="KnobPosition"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding Content}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource Foreground.Gray}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Highlight}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource Highlight}"/><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Highlight}"/><Setter TargetName="Ellipse" Property="Fill" Value="{DynamicResource Main.Background.lvl1}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Foreground.White}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter TargetName="Border" Property="Background" Value="{DynamicResource Main.Background.lvl3}"/><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Foreground.Gray}"/><Setter TargetName="Ellipse" Property="Fill" Value="{DynamicResource Foreground.Gray}"/></Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/></MultiDataTrigger.Conditions>
                    <Setter TargetName="Ellipse" Property="RenderTransform"><Setter.Value><TranslateTransform X="16"/></Setter.Value></Setter>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>