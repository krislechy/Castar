<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ToolTip">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource Castar.Field}"/>
        <Setter Property="Foreground" Value="{DynamicResource Foreground.White}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Name="Border" CornerRadius="{DynamicResource Castar.Corner.Control}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                BorderBrush="{DynamicResource Castar.FieldBorder}"
                Background="{TemplateBinding Background}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{DynamicResource Svg.Tooltip}"/>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
