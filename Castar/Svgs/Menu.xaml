<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MenuIconStroke" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Canvas}}"/>
        <Setter Property="StrokeThickness" Value="1.75"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Viewbox x:Key="Svg.Menu.Purchases" Stretch="Uniform" x:Shared="false">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource MenuIconStroke}"
                  Data="M6,3 H18 V21 L15,19 12,21 9,19 6,21 Z M9,7 H15 M9,11 H15 M9,15 H12"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Incomes" Stretch="Uniform" x:Shared="false">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource MenuIconStroke}"
                  Data="M12,3 V14 M8,10 L12,14 16,10 M5,14 V18 Q5,21 8,21 H16 Q19,21 19,18 V14"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Statistics" Stretch="Uniform" x:Shared="false">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource MenuIconStroke}"
                  Data="M4,4 V20 H21 M8,16 V12 M12,16 V9 M17,16 V5"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Settings" Stretch="Uniform" x:Shared="false">
        <Canvas Width="24" Height="24">
            <Path Style="{StaticResource MenuIconStroke}"
                  Data="M4,6 H8 M12,6 H20 M10,4 A2,2 0 0 1 10,8 A2,2 0 0 1 10,4 Z
                        M4,12 H14 M18,12 H20 M16,10 A2,2 0 0 1 16,14 A2,2 0 0 1 16,10 Z
                        M4,18 H6 M10,18 H20 M8,16 A2,2 0 0 1 8,20 A2,2 0 0 1 8,16 Z"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
