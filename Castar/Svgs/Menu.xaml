<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox x:Key="Svg.Menu.Purchases" x:Shared="false" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.receipt-text}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Incomes" x:Shared="false" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.download}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Statistics" x:Shared="false" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.chart-column-increasing}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Settings" x:Shared="false" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.settings}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Menu.Categories" x:Shared="false" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.tags}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
