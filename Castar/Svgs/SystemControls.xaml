<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox x:Key="Svg.Close" x:Shared="false" Stretch="Uniform" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.x}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Minimize" x:Shared="false" Stretch="Uniform" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.minus}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Maximize.1" x:Shared="false" Stretch="Uniform" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.square}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="Svg.Maximize.2" x:Shared="false" Stretch="Uniform" Width="16" Height="16">
        <Canvas Width="24" Height="24">
            <Path Data="{StaticResource Lucide.copy}" Style="{StaticResource LucideAliasStroke}"/>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
